/// Veza roditelj — dete (Pravilnik o učešću dece, čl. 2 st. 4 i čl. 7).
///
/// Dete ima najviše dva roditelja i **oba imaju ista ovlašćenja**: prekidač za
/// odrasle, uklanjanje oglasa, uvid u razgovore sa punoletnim licima i brisanje
/// naloga. Zato veza živi u zasebnoj tabeli, a ne kao kolona na nalogu deteta —
/// kolona bi jednog roditelja činila nosiocem, a drugog dopisanim.
///
/// 🔴 Prazan skup redova za dete NIJE greška u podacima nego stanje: „dete na
/// čekanju" je nalog koji se registrovao sam i čeka da ga roditelj preuzme.
model Roditeljstvo {
  id                String                    @id @default(uuid())
  deteId            String
  dete              User                      @relation("RoditeljstvoDete", fields: [deteId], references: [id], onDelete: Cascade)
  roditeljId        String
  roditelj          User                      @relation("RoditeljstvoRoditelj", fields: [roditeljId], references: [id], onDelete: Cascade)
  createdAt         DateTime                  @default(now())
  // Izjava roditelja pod punom odgovornoscu da ima dete tog uzrasta (cl. 6 st. 1).
  //
  // Potvrda opstaje samo ako su se izjasnila OBA clana veze — potvrdjivac i sam
  // roditelj. Roditelj po pravilu izjavu daje u trenutku u kome preuzima
  // odgovornost za nalog (otvaranje po cl. 4, preuzimanje po cl. 4b), pa mu tada
  // `izjavaAt` i `izjavaTekst` nastaju odmah, a `izjavaRokDo` ostaje prazan.
  //
  // 🔴 Tekst se SNIMA i posle toga se ne menja — isti razlog kao `ugovorTekst` kod
  // donacije i `izjavaTekst` kod operativnog doprinosa: dokument mora da govori ono
  // sto je govorio u trenutku davanja. Ne generisati ga ponovo pri citanju.
  izjavaAt          DateTime?
  izjavaTekst       String?
  /// Saglasnost roditelja na obradu podataka deteta (ZZPL cl. 16; Politika 4.7),
  /// ODVOJENO od izjave o postojanju deteta iznad (R-06).
  ///
  /// 🔴 Zasto se ne oslanja na izjavu, koja saglasnost usput pominje: to su dve
  /// izjave razlicitog dejstva. Izjava o postojanju deteta je tvrdnja o cinjenici,
  /// daje se pod punom odgovornoscu i njen izostanak obara potvrde TRECIH lica
  /// (cl. 6 st. 3). Saglasnost na obradu se po ZZPL cl. 15 st. 3 povlaci u svakom
  /// trenutku, bez razloga i bez posledica po bilo koga drugog. Spojene u jedan
  /// tekst, opoziv saglasnosti ne bi mogao da se izvrsi a da ne obori i tvrdnju o
  /// postojanju deteta — dakle pravo na opoziv faktycki ne bi postojalo.
  ///
  /// Daje se u istom potezu u kom i izjava (otvaranje naloga po cl. 4, preuzimanje
  /// po cl. 4b), pa roditelj ne radi dvaput.
  ///
  /// 🟡 Zatecene veze ostaju prazne — retroaktivno upisana „data saglasnost" bila
  /// bi netacan dokument, isto pravilo kao kod `izjavaTekst` i `ugovorTekst`.
  saglasnostAt      DateTime?
  saglasnostTekst   String?
  // Popunjen samo kad izjava NEDOSTAJE i tece rok — jedini takav slucaj je
  // administrativno prevodjenje punoletnog naloga u maloletni, gde roditelj nije
  // izvrsio nijednu radnju kojom bi izjavu dao. Neaktivnost roditelja do ovog roka
  // obara sve potvrde koje za to dete cekaju izjasnjenje.
  izjavaRokDo       DateTime?
  /// Veza je privremeno zaustavljena po prijavi lažnog roditeljstva (deca čl. 17
  /// st. 2, set 4.8.2). Dok traje, roditelj nema ovlašćenja ni uvid, a dete nije
  /// dete Kola po ovoj vezi. Null = veza radi.
  zaustavljenaAt    DateTime?
  potvrdePostojanja PotvrdaPostojanjaDeteta[]
  prijave           PrijavaRoditeljstva[]

  @@unique([deteId, roditeljId])
  @@index([deteId])
  @@index([roditeljId])
  @@index([izjavaRokDo])
}

/// Poziv roditelju pri samostalnoj registraciji deteta (Pravilnik o učešću dece, čl. 8 i 10).
///
/// Dete unosi svoj pseudonim i **email roditelja**; datum rođenja ne unosi — njega
/// upisuje roditelj pri preuzimanju. Roditelju stiže poruka sa tri radnje: preuzmi
/// nalog, ovo nije moje dete, obriši nalog.
///
/// Dva roka, i namerno su različita:
///  - `tokenDo` (sedam dana) — koliko važi jednokratni link iz poruke;
///  - `brisanjeDo` (četrnaest dana od registracije) — koliko nalog uopšte sme da
///    postoji bez preuzimanja. Dete na čekanju je lice čiji se podaci obrađuju PRE
///    pribavljenog pristanka roditelja, i to ne sme da traje neograničeno.
///
/// `kod` je rezervni put: šest cifara vidljivih u profilu deteta, koje roditelj
/// unosi uz pseudonim kad poruka ne stigne ili link istekne. Zato traje koliko i
/// `brisanjeDo`, a ne koliko token.
model RoditeljPoziv {
  id           String    @id @default(uuid())
  deteId       String    @unique
  dete         User      @relation(fields: [deteId], references: [id], onDelete: Cascade)
  // Podatak o TREĆEM LICU koji unosi dete. Ne proverava se i ne koristi se ni za
  // šta osim za slanje jedne poruke — zato u njoj stoji samo pseudonim deteta,
  // nikad njegovo pravo ime.
  email        String
  token        String    @unique
  kod          String
  tokenDo      DateTime
  brisanjeDo   DateTime
  iskoriscenAt DateTime?
  // „Ovo nije moje dete" — nalog ostaje do isteka `brisanjeDo`, ali poziv je mrtav
  // i poruka se ne šalje ponovo na istu adresu.
  odbijenAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([brisanjeDo])
}

// ─── Modul Deca — potvrda roditeljstva (Pravilnik o Modulu Deca, čl. 6) ──────
//
// Nalog deteta radi od trenutka otvaranja (čl. 4 st. 1). Lica koja su potvrdila
// stvarnost roditelja imaju TRIDESET DANA da potvrde da roditelj ima dete tog
// uzrasta. Ko se ne izjasni, gubi sopstvenu potvrdu stvarnosti tog roditelja:
// poništavaju se zapisi POEN-a evidentirani povodom te potvrde i oslobađa mu se
// verifikacioni slot (čl. 6 st. 3).
//
// Potvrda se daje ZA SVAKO DETE POSEBNO — otud `@@unique([deteId, potvrdjivacId])`,
// a ne po roditelju. Čovek sa četvoro dece traži četiri odvojena izjašnjenja.
//
// Veza ka `VerifikacionaVeza` se NE čuva: veza se pri poništenju briše, pa bi strani
// ključ ostao viseći. Merodavan je par (potvrđivač, roditelj), koji je u
// `VerifikacionaVeza` ionako jedinstven.
model RoditeljstvoPotvrda {
  id            String                    @id @default(uuid())
  deteId        String
  dete          User                      @relation("PotvrdaDete", fields: [deteId], references: [id], onDelete: Cascade)
  // Roditelj o čijem se detetu izjašnjava. Do seta 4.5.2 ga red nije nosio, pa se
  // pri isteku roka nije znalo koja tačno veza pada — kod deteta sa dvoje roditelja
  // padale su SVE potvrde tog potvrđivača, i onima koji sa istekom nemaju veze.
  // Čl. 6 st. 3 govori o potvrdi stvarnosti TOG roditelja, dakle o jednoj vezi.
  roditeljId    String
  roditelj      User                      @relation("PotvrdaRoditelj", fields: [roditeljId], references: [id])
  potvrdjivacId String
  potvrdjivac   User                      @relation("PotvrdaPotvrdjivac", fields: [potvrdjivacId], references: [id])
  status        RoditeljstvoPotvrdaStatus @default(CEKA)
  // Obavezno uz osporavanje (čl. 6 st. 6). Uz potvrdu se ne traži.
  obrazlozenje  String?
  rokDo         DateTime
  // Poslednji prag podsetnika koji je poslat (u danima do isteka), npr. 30, 7, 1.
  // Jedno polje drzi ceo raspored i cini posao idempotentnim: podsetnik se salje
  // samo kad je zatecena vrednost prazna ili veca od praga koji je sada na redu.
  podsetnikDana Int?
  odgovorAt     DateTime?
  createdAt     DateTime                  @default(now())

  @@unique([deteId, roditeljId, potvrdjivacId])
  @@index([potvrdjivacId, status])
  @@index([status, rokDo])
  @@index([roditeljId, status])
}

/// Ishod odlučivanja roditelja o prepisu iznad praga (Pravilnik o učešću dece, čl. 30).
enum PrepisOdobrenjeStatus {
  CEKA
  ODOBREN
  ODBIJEN
  ISTEKAO
}

/// Prepis POEN-a iz zapisa maloletnog korisnika koji čeka odobrenje roditelja
/// (Pravilnik o učešću dece, čl. 30).
///
/// 🔴 Ovo NIJE transakcija i NE ulazi u zero-sum. POEN se ne pomera dok roditelj
/// ne odobri; do tada ovde stoji samo NAMERA. Kad bi se POEN skidao unapred,
/// odbijen ili istekao prepis tražio bi povraćaj, a povraćaj je protivzapis koji
/// bi u istoriji izgledao kao poništenje — što nije.
model PrepisOdobrenje {
  id         String                @id @default(uuid())
  deteId     String
  dete       User                  @relation("PrepisDete", fields: [deteId], references: [id], onDelete: Cascade)
  primalacId String
  primalac   User                  @relation("PrepisPrimalac", fields: [primalacId], references: [id], onDelete: Cascade)
  iznos      Int
  opis       String?
  status     PrepisOdobrenjeStatus @default(CEKA)
  rokDo      DateTime
  odlucioId  String?
  odlucenoAt DateTime?
  createdAt  DateTime              @default(now())

  @@index([deteId, status])
  @@index([status, rokDo])
}

/// Potvrda postojanja deteta od strane Fondacije (Pravilnik o učešću dece čl. 6,
/// set 4.8.0). Kad stvarnost roditelja nije potvrđena u lancu nego uplatom (dokaz
/// stvarnosti čl. 4a), nema lica koja bi se pitala; drugu stranu postupka tada čini
/// Fondacija, posle razgovora sa roditeljem. Isprave se ne traže i ne čuvaju.
/// Rok i poništenje potvrde zbog neaktivnosti se ne primenjuju.
model RoditeljstvoPotvrdaFondacije {
  id           String                    @id @default(uuid())
  deteId       String
  dete         User                      @relation("PotvrdaFondacijeDete", fields: [deteId], references: [id], onDelete: Cascade)
  roditeljId   String
  roditelj     User                      @relation("PotvrdaFondacijeRoditelj", fields: [roditeljId], references: [id], onDelete: Cascade)
  status       RoditeljstvoPotvrdaStatus @default(CEKA)
  // Ko je iz Fondacije razgovarao sa roditeljem i odlučio.
  odlucioId    String?
  odlucio      User?                     @relation("PotvrdaFondacijeOdlucio", fields: [odlucioId], references: [id], onDelete: SetNull)
  // Obavezno uz osporavanje (čl. 6), kao i kod potvrđivača.
  obrazlozenje String?
  odgovorAt    DateTime?
  createdAt    DateTime                  @default(now())

  @@unique([deteId, roditeljId])
  @@index([status])
}

enum RoditeljstvoPotvrdaStatus {
  CEKA
  POTVRDIO
  // Osporavanje postojanja deteta — ide Upravnom odboru (čl. 6 st. 6).
  OSPORIO
  // Rok istekao bez izjašnjenja jedne od dve strane (potvrđivača ili roditelja);
  // potvrda stvarnosti roditelja je pala. Izjašnjenje dato posle roka ne otklanja
  // nastupelo poništenje samo po sebi — put je prigovor po čl. 6 st. 4.
  ISTEKLA
}

/// Odakle potvrda postojanja deteta (Pravilnik o učešću dece čl. 13, 37; set 4.8.2).
enum IzvorPotvrdePostojanja {
  /// Potvrdio član Kola ili osnivač koji roditelja lično zna (čl. 13 st. 3).
  CLAN_KOLA
  /// Zatečena potvrda iz ranijeg postupka (čl. 37, prva rečenica).
  ZATECENA
  /// Dete osnivača povezano pre stupanja na snagu (čl. 37, druga rečenica).
  OSNIVAC_PRELAZNA
}

/// Potvrda postojanja deteta (Pravilnik o učešću dece čl. 13, set 4.8.2). Zahtev se
/// podnosi za svako dete posebno, bez roka; potvrda je bez POEN-a. Stari postupak
/// (`RoditeljstvoPotvrda`, `RoditeljstvoPotvrdaFondacije`) nema novih upisa.
/// `aktivnaKljuc` = `roditeljstvoId` dok je zahtev otvoren ili potvrđen.
model PotvrdaPostojanjaDeteta {
  id              String                  @id @default(uuid())
  /// Null kad je veza ukinuta (deca čl. 18): potvrda i njen nadzorni predmet ostaju,
  /// da bi se moglo oceniti da li je potvrda bila lažna (deca čl. 13 st. 5).
  roditeljstvoId  String?
  roditeljstvo    Roditeljstvo?           @relation(fields: [roditeljstvoId], references: [id], onDelete: SetNull)
  deteId          String
  dete            User                    @relation("PostojanjeDete", fields: [deteId], references: [id], onDelete: Cascade)
  /// Denormalizovano zbog upita.
  roditeljId      String
  roditelj        User                    @relation("PostojanjeRoditelj", fields: [roditeljId], references: [id], onDelete: Cascade)
  /// Null kod prelaznih (ZATECENA, OSNIVAC_PRELAZNA).
  trazenoAt       DateTime?
  izvor           IzvorPotvrdePostojanja?
  potvrdioId      String?
  potvrdio        User?                   @relation("PostojanjePotvrdio", fields: [potvrdioId], references: [id], onDelete: SetNull)
  potvrdjenoAt    DateTime?
  podlezeNadzoru  Boolean                 @default(false)
  nadzornikId     String?
  nadzoranAt      DateTime?
  nadzorIshod     NadzorIshod?
  nadzorZapisi    NadzorZapis[]
  nadzorniPredmet NadzorniPredmet?
  ponistenaAt     DateTime?
  ponistioId      String?
  aktivnaKljuc    String?                 @unique
  createdAt       DateTime                @default(now())

  @@index([deteId])
  @@index([roditeljId])
  @@index([potvrdioId])
  @@index([podlezeNadzoru, nadzorIshod])
}

enum PrijavaRoditeljstvaStatus {
  OTVORENA
  NEMA_OSNOVA
  UKINUTA
}

/// Prijava lažnog roditeljstva (Pravilnik o učešću dece čl. 17, set 4.8.2). Po
/// prijavi se veza odmah zaustavlja. 🔴 Podnosilac se NE otkriva licu na koje se
/// prijava odnosi. `roditeljId` je snimak (veza se pri ukidanju briše).
model PrijavaRoditeljstva {
  id             String                    @id @default(uuid())
  roditeljstvoId String?
  roditeljstvo   Roditeljstvo?             @relation(fields: [roditeljstvoId], references: [id], onDelete: SetNull)
  deteId         String
  dete           User                      @relation("PrijavaRoditeljstvaDete", fields: [deteId], references: [id], onDelete: Cascade)
  roditeljId     String
  podnosilacId   String
  podnosilac     User                      @relation("PrijavaRoditeljstvaPodnosilac", fields: [podnosilacId], references: [id], onDelete: Cascade)
  opis           String
  status         PrijavaRoditeljstvaStatus @default(OTVORENA)
  odlucioId      String?
  odlucenoAt     DateTime?
  obrazlozenje   String?
  createdAt      DateTime                  @default(now())

  @@index([status, createdAt])
  @@index([deteId])
  @@index([podnosilacId])
}

/// Napušteni pseudonimi. Dve svrhe, obe posledica toga što pseudonim stoji u
/// adresi profila (`/profil/<pseudonim>`):
///
///  1. **Stari linkovi ostaju živi.** Posle preimenovanja `/profil/StaroIme` i
///     dalje vodi na istog čoveka (stranica potom prepiše adresu u novu).
///  2. **Napušteno ime se ne može preuzeti.** Bez ovoga bi neko drugi uzeo
///     oslobođeni pseudonim, pa bi ranije podeljeni link tiho vodio na DRUGU
///     osobu — što je gore od mrtvog linka, jer izgleda ispravno.
///
/// Red se briše kad se korisnik vrati na svoje staro ime i pri gašenju naloga
/// (Pravilnik čl. 33 st. 4 — pseudonimizacija; napušteni pseudonim je i dalje trag o nalogu).
model PseudonimIstorija {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pseudonim      String
  pseudonimLower String   @unique
  promenjenAt    DateTime @default(now())

  @@index([userId])
}

/// Cirkularno SISTEMSKO obaveštenje svim korisnicima — izmene Uslova/Politike
/// (Uslovi čl. 43, Politika čl. 47), planirani zastoj duži od 24h (Uslovi čl. 36)
/// i slična obaveštenja koja Fondacija duguje korisnicima.
///
/// NE poštuje `User.emailObavestenja` — to je obaveza iz akata, ne izbor. Zato je
/// `pravniOsnov` obavezan i upisuje se u audit log: sistemska pošta bez osnova iz
/// akata je bilten, a bilten traži zaseban pristanak i dopunu Politike (čl. 39,
/// gde je Resend deklarisan isključivo za sistemska obaveštenja).
///
/// Slanje je nastavljivo: `kursorId` je poslednji obrađeni `User.id` u stabilnom
/// redosledu po id-u, pa ponovno pokretanje nastavlja odatle i ne šalje dvaput.
model SistemskoObavestenje {
  id          String          @id @default(uuid())
  naslov      String
  tekst       String
  /// Relativna putanja u aplikaciji (npr. "/uslovi"), opciono.
  link        String?
  /// Odredba akta iz koje proizlazi obaveza slanja (npr. "Uslovi čl. 43").
  pravniOsnov String
  status      SistemskoStatus @default(NACRT)
  ukupno      Int             @default(0)
  poslato     Int             @default(0)
  neuspesno   Int             @default(0)
  kursorId    String?
  kreiraoId   String
  kreirao     User            @relation("KreiraoObavestenje", fields: [kreiraoId], references: [id])
  createdAt   DateTime        @default(now())
  pokrenutoAt DateTime?
  zavrsenoAt  DateTime?

  @@index([status, createdAt(sort: Desc)])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Potvrda imejl adrese koju maloletni korisnik sam upiše (Pravilnik o učešću dece,
/// čl. 26 st. 1 — školu i ostale dobrovoljne podatke navodi sámo dete).
///
/// 🔴 Adresa se NE upisuje u `User.email` dok se ne potvrdi klikom na link poslat
/// NA NJU. Bez tog koraka jedna omaška u kucanju predaje ključ od dečjeg naloga
/// nepoznatoj osobi: tok „zaboravljena lozinka" šalje link upravo na upisanu
/// adresu. Do potvrde adresa živi samo u ovom redu i ne radi ništa.
///
/// Red se ne briše posle upotrebe (`usedAt`), da se isti link ne bi upotrebio
/// dvaput; čisti ga isti posao koji čisti istekle tokene.
model EmailPotvrda {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserPodaci {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  punoIme   String?
  opis      String?
  updatedAt DateTime @updatedAt

  // Vidljivost profila
  prikaziLokaciju     Boolean @default(true)
  prikaziOpis         Boolean @default(false)
  prikaziPunoIme      Boolean @default(false)
  prikaziTelefon      Boolean @default(false)
  prikaziBilans       Boolean @default(true)
  prikaziZrno         Boolean @default(true)
  prikaziRangDonacija Boolean @default(true)
  prikaziOglase       Boolean @default(true)
}

model Wallet {
  id         String        @id @default(uuid())
  userId     String?       @unique
  user       User?         @relation(fields: [userId], references: [id])
  krugId     String?       @unique
  krug       Krug?         @relation("KrugWallet", fields: [krugId], references: [id])
  balance    Int           @default(0)
  type       WalletType
  outgoingTx Transaction[] @relation("FromWallet")
  incomingTx Transaction[] @relation("ToWallet")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Transaction {
  id            String          @id @default(uuid())
  fromWalletId  String?
  fromWallet    Wallet?         @relation("FromWallet", fields: [fromWalletId], references: [id])
  toWalletId    String
  toWallet      Wallet          @relation("ToWallet", fields: [toWalletId], references: [id])
  amount        Int
  type          TransactionType
  /**
   * Gotov srpski opis — UVEK popunjen (rezerva i stari redovi).
   */
  description   String?
  /**
   * Ključ u messages/*.json, npr. "transakcije.verifikacija".
   */
  opisKljuc     String?
  /**
   * Vrednosti za {pseudonim}, {iznos}, {krug}...
   */
  opisParametri Json?
  createdAt     DateTime        @default(now())

  /// Prijava na socijalni program po kojoj je zapis nastao (set 4.6.7, R-03).
  ///
  /// 🔴 Ovde stoji VEZA, a ne naziv programa. Naziv se izvodi iz prijave, jer je
  /// zapis transakcije trajan i ide u GDPR izvoz — upisan naziv se više nikad ne
  /// bi mogao suziti ako se odluka o prikazu promeni, dok prijava prestankom
  /// osnova nosi svoj prikaz sa sobom. Isto pravilo po kome opis zapisa i dalje
  /// glasi samo „Socijalni program" (`OPIS_SOCIJALNOG_PROGRAMA`).
  ///
  /// 🔴 Zatečeni redovi ostaju `null` i NE popunjavaju se naknadno (pravilo o
  /// snimljenom tekstu): veza koja nije postojala u svom trenutku ne sme se
  /// izmisliti danas. Posledica je da stariji zapisi ne ulaze u pojedinačan
  /// prikaz — ulaze u dnevni zbir, kao i do sada.
  ///
  /// `onDelete: SetNull` — brisanjem prijave (prestanak statusa korisnika, Pravilnik čl. 33)
  /// gasi se prikaz, a sam zapis ostaje. Kaskadno brisanje zapisa oborilo bi
  /// zero-sum.
  enrollmentId String?
  enrollment   ProgramEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  /// Prijava da razmena povodom ovog prepisa nije ispunjena (najviše jedna).
  prijavaRazmene PrijavaRazmene?

  @@index([type, enrollmentId])
}

model Krug {
  id             String            @id @default(uuid())
  name           String            @unique
  description    String?
  location       String?
  status         KrugStatus        @default(ACTIVE)
  /// Krug i zadruga su ISTI kolektivni oblik pod drugim imenom (Pravilnik o
  /// zadrugama do seta 5.0, čl. 11 st. 3). `zadruga = true` znači da je upisana zadruga sa ugovorom
  /// o saradnji; zapis i pragovi ostaju isti, pa se dostignut prag ne ponavlja.
  zadruga        Boolean           @default(false)
  zadruzniAdmini User[]            @relation("ZadruzniAdmini")
  maticniBroj    String?
  pib            String?
  adresa         String?
  /// Dan zaključenja ugovora o saradnji (zadruge čl. 4 st. 1 t. 2).
  ugovorAt       DateTime?
  /// Prestanak učešća (zadruge čl. 22) — zapis se zatvara, POEN se poništava.
  prestanakAt    DateTime?
  /// Od otkaza ugovora o saradnji, odnosno pokretanja brisanja iz registra (zadruge
  /// 5.0 čl. 22 st. 2; Pravilnik čl. 50 st. 4): iz zapisa i u njega se ne prepisuje, a
  /// zadružni doprinos se ne evidentira. Zapis ostaje otvoren do prestanka učešća.
  zamrznutoAt    DateTime?
  /// OTKAZ_UGOVORA | BRISANJE_IZ_REGISTRA (`OSNOVI_ZAMRZAVANJA` u zadruga-pravila.ts).
  zamrznutoOsnov String?
  wallet         Wallet?           @relation("KrugWallet")
  memberships    KrugClanstvo[]
  pristupnice    KrugPristupnica[]
  projects       KrugProjekat[]
  bonusLogs      KrugBonusLog[]
  doprinosOglasi DoprinosOglas[]   @relation("KrugOglasi")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model KrugClanstvo {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  krugId      String
  krug        Krug      @relation(fields: [krugId], references: [id])
  isAdmin     Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  /// Ime i prezime zadrugara koje dostavlja zadruga, uz pristanak lica (Pravilnik
  /// o zadrugama čl. 6 st. 2, Registar radnji obrade br. 19). 🔴 Ne prikazuje se drugim
  /// korisnicima; briše se prestankom svojstva i gašenjem naloga — veza ostaje
  /// pseudonimna, jer broji pragove koji su već evidentirani.
  imePrezime  String?
  pristanakAt DateTime?

  @@index([userId, leftAt])
  @@index([krugId, leftAt])
}

model KrugOsnivanjeZahtev {
  id              String              @id @default(uuid())
  name            String
  description     String?
  location        String?
  inicijatorId    String
  inicijator      User                @relation("Inicijator", fields: [inicijatorId], references: [id])
  osnivaci        String[]
  status          KrugOsnivanjeStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime            @default(now())
}

model KrugPristupnica {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  krugId    String
  krug      Krug              @relation(fields: [krugId], references: [id])
  status    PristupnicaStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@unique([userId, krugId])
}

model KrugProjekat {
  id          String      @id @default(uuid())
  krugId      String
  krug        Krug        @relation(fields: [krugId], references: [id])
  type        ProjectType
  title       String
  description String
  status      String      @default("ACTIVE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model KrugBonusLog {
  id        String   @id @default(uuid())
  krugId    String
  krug      Krug     @relation(fields: [krugId], references: [id])
  threshold Int
  amount    Int
  createdAt DateTime @default(now())

  // Svaki prag rasta kruga se isplaćuje tačno jednom (race-safe rezervacija praga).
  @@unique([krugId, threshold])
}

model MarketplaceListing {
  id             String        @id @default(uuid())
  sellerId       String
  seller         User          @relation("SellerListings", fields: [sellerId], references: [id])
  primalacId     String?
  primalac       User?         @relation("PrimalacListings", fields: [primalacId], references: [id])
  // Smer oglasa (ponuda vs potražnja). Kod POTRAZNJA je cenaTip uvek DOGOVOR.
  tip            TipOglasa     @default(PONUDA)
  title          String
  description    String
  // Cena ima tri varijante (bira ih oglašivač):
  //  - FIKSNA  → jedan iznos u `price` (cenaDo = null)
  //  - RASPON  → `price` = donja granica, `cenaDo` = gornja granica
  //  - DOGOVOR → bez iznosa („po dogovoru"); price = cenaDo = null
  // `price` (donja granica/fiksna cena) ostaje numerička osnova za sortiranje i min/max filter.
  cenaTip        CenaTip       @default(FIKSNA)
  price          Int?
  cenaDo         Int?
  // Opciona jedinica mere za cenu (kom, kg, g, l, ml, m, pak) i stanje na zalihama.
  // Oba su informativna — ne utiču na tok kupovine (oglas se i dalje kupuje u celosti).
  jedinica       String?
  kolicina       Int?
  category       String
  images         String[]
  location       String?
  phone          String?
  status         ListingStatus @default(ACTIVE)
  razmenjenoAt   DateTime?
  // Broj otvaranja stranice oglasa. Ne broje se pregledi samog oglašivača, a
  // isti posetilac se broji jednom dnevno (guard je u pretraživaču). Vidi ga
  // SAMO oglašivač — povratna informacija da oglas nije otišao u prazno.
  pregledi       Int           @default(0)
  // Uklanjanje od strane Fondacije (Uslovi čl. 23 st. 5 i čl. 29 st. 2). Razlog je
  // obavezan jer se korisniku mora saopštiti — nije opcioni komentar za internu upotrebu.
  uklonjenAt     DateTime?
  uklonjenRazlog String?
  uklonioId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  prijave      PrijavaOglasa[]
  doprinosi    DoprinosSadrzaju[]
  poruke       Poruka[]           @relation("PorukaOglas")
  povodKonverz Konverzacija[]     @relation("KonvPovod")

  /// Oglas postavljen u ime gazdinstva (Pravilnik o gazdinstvima čl. 18). Oznaka
  /// DOMAĆE se ne čuva — izvodi se iz toga da je gazdinstvo odobreno i da je
  /// oglašivač i dalje njegov član, pa ne može da preživi poništenje ni istupanje.
  gazdinstvoId String?
  gazdinstvo   Gazdinstvo? @relation(fields: [gazdinstvoId], references: [id], onDelete: SetNull)

  @@index([status, category, createdAt])
  @@index([status, tip, createdAt])
}

/**
 * Prijava oglasa od strane korisnika (Uslovi čl. 29 st. 2 — Fondacija može ukloniti
 * sadržaj „koji je prijavljen od strane drugih korisnika kao problematičan").
 * Jedan korisnik može prijaviti isti oglas samo jednom (@@unique) — inače je
 * brojač prijava merilo glasnosti, a ne ozbiljnosti.
 */
model PrijavaOglasa {
  id          String              @id @default(uuid())
  oglasId     String
  oglas       MarketplaceListing  @relation(fields: [oglasId], references: [id], onDelete: Cascade)
  prijaviocId String
  prijavioc   User                @relation("PrijaviocOglasa", fields: [prijaviocId], references: [id])
  razlog      PrijavaRazlog
  opis        String?
  status      PrijavaOglasaStatus @default(OTVORENA)
  resioId     String?
  resenoAt    DateTime?
  createdAt   DateTime            @default(now())

  @@unique([oglasId, prijaviocId])
  @@index([status, createdAt(sort: Desc)])
  @@index([oglasId])
}

/**
 * Razlozi prijave — prate zabrane iz Uslova čl. 22, 23, 27 i 28.
 */
enum PrijavaRazlog {
  ZABRANJENO_DOBRO // čl. 23 — dobra/usluge čiji je promet zabranjen
  OBMANA // čl. 22 st. 2 — lažan ili obmanjujuć prikaz dobra/usluge
  UVREDLJIVO // čl. 27 st. 2 — uznemiravanje, pretnje, diskriminacija
  LICNI_PODACI // čl. 28 st. 1 — lični podaci trećih lica
  PREVARA // čl. 28 st. 1 — prevara, manipulacija, nezakonita aktivnost
  TRGOVINA_POENOM // čl. 23 st. 2 i čl. 28 st. 3 — oglas za zamenu POEN-a za novac
  DRUGO
}

enum PrijavaOglasaStatus {
  OTVORENA
  RESENA // oglas uklonjen povodom prijave
  ODBACENA // pregledano, nema povrede
}

/**
 * Prijava da razmena povodom prepisa POEN-a nije ispunjena.
 * Prepis je ažuriranje evidencije između dva zapisa (Pravilnik čl. 17, 20) i
 * ne poništava se sam od sebe — za razmenu odgovaraju sami korisnici po
 * obligacionom pravu, a Fondacija nije strana u tom odnosu (Uslovi čl. 24).
 * Zato ovo NIJE automatski povraćaj nego evidencija prijave o kojoj Fondacija
 * odlučuje: može da poništi prepis protivzapisom ili da prijavu odbaci.
 * Prijavljuje ISKLJUČIVO onaj ko je POEN prepisao — samo on je nešto izgubio.
 * Jedna prijava po prepisu (@@unique na `transakcijaId`): druga prijava nad
 * istim prepisom ne bi bila nov podatak nego ponovljen pritisak.
 */
model PrijavaRazmene {
  id            String      @id @default(uuid())
  transakcijaId String      @unique
  transakcija   Transaction @relation(fields: [transakcijaId], references: [id], onDelete: Cascade)

  /// Onaj ko je prepisao POEN i nije dobio dogovoreno.
  prijaviocId String
  prijavioc   User   @relation("PrijaviocRazmene", fields: [prijaviocId], references: [id])
  /// Druga strana razmene — onaj kome je POEN prepisan.
  protivId    String
  protiv      User   @relation("ProtivRazmene", fields: [protivId], references: [id])

  /// Prigovor sa profila kroz koji je slučaj otvoren (Uslovi čl. 40). Ulazna
  /// tačka je od 4.5.4 isključivo profil — dugme uz prepis u istoriji je uklonjeno.
  prigovorId String?           @unique
  prigovor   PrigovorNaOdluku? @relation(fields: [prigovorId], references: [id])

  opis   String
  status PrijavaRazmeneStatus @default(OTVORENA)

  /// 🔴 Rok u kome se druga strana izjašnjava PRE odluke (Uslovi čl. 40 st. 5).
  /// Odluka se ne donosi dok rok ne istekne ili dok se druga strana ne izjasni —
  /// to sprovodi `ponistiPrepis`, pa je norma svojstvo redosleda, ne obećanje.
  izjasnjenjeDo   DateTime?
  odgovorProtiv   String?
  odgovorProtivAt DateTime?

  /// Obrazloženje odluke Fondacije — obavezno u oba ishoda, ide prijaviocu.
  odluka  String?
  resioId String?
  resenAt DateTime?
  /// Koliko je POEN-a stvarno vraćeno. Može biti manje od prepisanog iznosa i
  /// može biti 0: zapis primaoca ne sme u minus (Pravilnik čl. 17), pa se vraća
  /// najviše ono što na njemu zatekne.
  vraceno Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([prijaviocId])
}

enum PrijavaRazmeneStatus {
  OTVORENA
  PONISTENA // prepis poništen protivzapisom (u celini ili delimično)
  ODBACENA // pregledano, prepis ostaje
}

/// Stanje doprinosa sadržaju platforme (Pravilnik čl. 38 st. 2).
/// ZABELEZEN nije zapis POEN-a — do evidentiranja ne ulazi ni u jedno stanje
/// računa, ni u opticaj, ni u javne agregate. To razdvajanje je pravno srce
/// kanala: drži zero-sum i sve pragove sistema van domašaja praznih naloga.
enum DoprinosStatus {
  ZABELEZEN
  EVIDENTIRAN
  PONISTEN // oglas uklonjen zbog povrede Uslova pre evidentiranja (Pravilnik čl. 38 st. 4)
}

/// Događaj koji je pretvorio zabeležen doprinos u zapis POEN-a (Pravilnik čl. 38 st. 2).
enum DoprinosOkidac {
  VERIFIKACIJA
  PRIMLJEN_POEN
  /// Verifikovan korisnik objavio kvalifikovan oglas — evidentira se odmah (ranije pravilo; Pravilnik čl. 38 st. 2 sada traži odobrenje).
  /// Ranije se zvao OBJAVA_VERIFIKOVAN; preimenovan 2026-08-11 (isto značenje).
  OBJAVA
  /// Fondacija odobrila prvi oglas naloga bez potvrde (Pravilnik čl. 38 st. 2, postupak Uslovi čl. 19) — glavni put
  /// do evidentiranja za neverifikovanog korisnika, admin tab „Prvi oglasi".
  ODOBRENJE
}

/// Doprinos sadržaju platforme — osmi kanal evidentiranja (Pravilnik čl. 19 t. 8,
/// čl. 38). Korisniku se jednokratno evidentira 1.000 POEN-a za prvi oglas kojim
/// nudi dobro ili uslugu i koji ispunjava sadržinski minimum iz Uslova.
///
/// `userId` je @unique — jednokratnost kanala po čoveku obezbeđuje BAZA, ne kod.
/// Bez toga bi dve paralelne objave oglasa mogle da zabeleže dva doprinosa.
///
/// Evidentiranje je automatski akt Protokola i NE ulazi u dnevni limit (Pravilnik čl. 19 st. 4).
model DoprinosSadrzaju {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Oglas povodom kog je doprinos zabeležen. Ostaje i posle brisanja oglasa
  /// (SetNull) — činjenica doprinosa se ne gubi sa sadržajem.
  oglasId String?
  oglas   MarketplaceListing? @relation(fields: [oglasId], references: [id], onDelete: SetNull)

  iznos  Int             @default(1000)
  status DoprinosStatus  @default(ZABELEZEN)
  okidac DoprinosOkidac?

  /// Transakcija kojom je doprinos evidentiran u Protokolu (postoji tek u EVIDENTIRAN).
  transakcijaId String?

  zabelezenAt      DateTime  @default(now())
  evidentiranAt    DateTime?
  ponistenAt       DateTime?
  /// Kad je korisniku javljeno da mu je doprinos evidentiran. Odvojeno od
  /// `evidentiranAt` jer obaveštenje sme da zakasni (ili da se ponovi ručno),
  /// a zapis POEN-a ne sme da čeka na njega. Null uz EVIDENTIRAN = duguje se javljanje.
  obavestenAt      DateTime?
  /// Ko je okinuo evidentiranje — verifikator, odnosno pošiljalac POEN-a.
  /// Plain string (bez FK) — služi osmatranju obrasca iz odeljka 05, ne integritetu.
  okidacKorisnikId String?

  @@index([status])
  @@index([okidacKorisnikId, evidentiranAt])
}

// ─── Doprinos razmeni — putanja prvog kruga (čl. 40a, lestvica od 5 koraka) ───

/// Doprinos razmeni — koraci 2–5 putanje prvog kruga (Pravilnik čl. 40a).
///
/// Korak 1 (prvi oglas + prvi primljen POEN) je zatečeni doprinos sadržaju i vodi
/// se u `DoprinosSadrzaju` — OVDE GA NEMA. Zato je `korak` u opsegu 2–5, a
/// doživotna kapa od 5.000 POEN-a proizlazi iz zbira: 1.000 (čl. 40a, korak 1) +
/// 4 × 1.000 (ova tabela). Kapu drži BAZA, ne kod: `@@unique([userId, korak])` uz
/// ograničenje opsega znači da korisnik ne može imati više od četiri reda ovde.
model DoprinosRazmeni {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Redni broj koraka na lestvici (2–5).
  korak  Int
  iznos  Int            @default(1000)
  status DoprinosStatus @default(ZABELEZEN)

  /// Transakcija kojom je korak evidentiran u Protokolu (postoji tek u EVIDENTIRAN).
  transakcijaId String?

  zabelezenAt   DateTime  @default(now())
  evidentiranAt DateTime?
  /// Kad je korisniku javljeno. Isti razlog za odvajanje kao kod `DoprinosSadrzaju`:
  /// zapis POEN-a ne sme da čeka na mejl/push, a javljanje ne sme da ode dvaput.
  obavestenAt   DateTime?

  @@unique([userId, korak])
  @@index([status])
}

// Kategorije Pijace koje korisnik prati (čipovi u profilu). Pri objavi oglasa
// pratioci dobijaju obaveštenje — `emitujNoviOglas` u src/lib/oglas-dogadjaji.ts.
// Vrednost `category` je jedan od 13 slugova iz src/lib/kategorije.ts
// (validira se u API sloju).
model FollowedCategory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  createdAt DateTime @default(now())

  @@unique([userId, category])
  @@index([category])
}

model ProtokolProgram {
  type        ProgramType @id
  isActive    Boolean     @default(false)
  activatedAt DateTime?
  updatedAt   DateTime    @updatedAt
}

model ProgramEnrollment {
  id                    String           @id @default(uuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id])
  type                  ProgramType
  status                EnrollmentStatus @default(PENDING)
  metadata              Json?
  dailyAmount           Int?
  // Izričit pristanak da verifikatori budu zamoljeni da potvrde ispunjenost uslova
  // (Pravilnik o programima podrške čl. 6 — pravni osnov obrade je pristanak).
  pristanakVerifikatori Boolean          @default(false)
  /// Tekst pristanka koji je korisnik video, SNIMLJEN, i trenutak davanja (R-06).
  ///
  /// 🔴 Do seta 4.6.3 je postojao samo `pristanakVerifikatori: true`. Logička
  /// vrednost dokazuje DA je pristanak dat, ali ne i NA ŠTA — a ovde je reč o
  /// izričitom pristanku za posebne kategorije podataka (ZZPL čl. 17 st. 2 t. 1),
  /// gde je sadržina pristanka ceo njegov pravni domet. Tekst se uz to menjao
  /// (10.09.2026, R-13) i nosi broj verifikatora koji je različit za svakog
  /// korisnika, pa se bez snimka ne može utvrditi šta je tom čoveku pisalo.
  ///
  /// 🔴 Sklapa se NA SERVERU, iz istog izvora iz kog se prikazuje; klijent šalje
  /// samo potvrdu. Ponovna prijava upisuje NOV pristanak — ne prepisuje stari.
  pristanakTekst        String?
  pristanakAt           DateTime?
  /// Jezik na kom je tekst prikazan (vidi `ZapisPristanka.jezik`).
  pristanakJezik        String?
  /// Kad je pristanak povučen (ZZPL čl. 15 st. 3).
  ///
  /// 🔴 `pristanakVerifikatori` se pri povlačenju NE vraća na `false`: pristanak
  /// jeste bio dat, a opoziv po čl. 15 st. 3 ne utiče na zakonitost obrade pre
  /// opoziva — pa dokaz da je postojao mora da ostane, zajedno sa tekstom. Gašenje
  /// logičke vrednosti tvrdilo bi da pristanka nikad nije ni bilo.
  pristanakPovucenAt    DateTime?
  approvedById          String?
  approvedAt            DateTime?
  rejectionReason       String?
  nextReverifikacija    DateTime?
  /// Zbir POEN-a evidentiranog po OVOM programu (R-03, mera M-1).
  ///
  /// 🔴 Postoji zato što opis transakcije više ne imenuje program: naziv je
  /// posebna kategorija po ZZPL čl. 17, pa je iz zapisa izašao. Bez ovog zbira bi
  /// korisnik izgubio uvid u sopstveni podatak — u istoriji POEN-a vidi redove
  /// „Socijalni program" i ne zna koji je koji. Razlaganje se zato prikazuje na
  /// kartici programa, gde mu je i kontekst.
  isplacenoPoen         Int              @default(0)
  /// Osnov po kome je pravo ostvareno u programu Posebna podrška (programi čl. 14).
  ///
  /// 🔴 Osnov se NE PRIKAZUJE nijednom korisniku (programi čl. 20 st. 3; čl. 6 st. 2 t. 5) — ni verifikovanom,
  /// kome je set 4.6.7 otvorio naziv programa i iznos. Program obuhvata i smanjenu
  /// sposobnost i gubitak doma, pa objavljen naziv ne kazuje koji je osnov u
  /// pitanju; prikaz osnova bio bi prikaz podatka o zdravlju, odnosno o prinudnoj
  /// raseljenosti, koja je blizu podatka o nacionalnoj pripadnosti.
  ///
  /// Postoji zato što od osnova zavisi TRAJANJE prava (programi čl. 18): smanjena sposobnost
  /// podleže godišnjoj reviziji, gubitak doma traje dvanaest meseci od događaja bez
  /// revizije. Finija razlika unutar smanjene sposobnosti (rešenje naspram izjave o
  /// akutnoj bolesti, koja traje šest meseci) živi u `metadata`, koju vidi samo
  /// lice što obrađuje prijavu — ona je bliža podatku o zdravlju od samog osnova.
  ///
  /// `null` za ostale programe i za zatečene prijave.
  osnov                 OsnovPodrske?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  potvrde               ProgramPotvrda[]
  /// Zapisi POEN-a evidentirani po ovoj prijavi (set 4.6.7) — iz njih se izvodi
  /// naziv programa u spisku, jer ga sam zapis ne nosi.
  transakcije           Transaction[]

  @@unique([userId, type])
  @@index([status, type])
}

// Potvrda verifikatora da prijavljeni korisnik ispunjava uslov socijalnog programa.
// Verifikator potvrđuje pod punom odgovornošću, na osnovu ličnog poznavanja osobe —
// NEMA uvid u osetljive prijavljene podatke (datumi rođenja dece, rešenje o
// invaliditetu i sl.), koji ostaju dostupni samo licu koje obrađuje prijavu (programi čl. 21 st. 3).
// Odbijanje zahteva obrazloženje.
model ProgramPotvrda {
  id            String            @id @default(uuid())
  enrollmentId  String
  enrollment    ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  verifikatorId String
  verifikator   User              @relation("VerifikatorPotvrda", fields: [verifikatorId], references: [id])
  status        PotvrdaStatus     @default(CEKA)
  obrazlozenje  String?
  odgovorAt     DateTime?
  /// Programi čl. 5 st. 5 „utvrđuje Fondacija": ispunjenost uslova potvrdila je
  /// Fondacija (nema podobnog člana Kola). `verifikatorId` je tada administrator
  /// koji je odluku upisao. Set 4.8.2.
  odFondacije   Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@unique([enrollmentId, verifikatorId])
  @@index([verifikatorId, status])
}

/// Preporuka člana (dokaz stvarnosti čl. 20, Registar radnja br. 23, set 4.8.0).
/// Jedan red po paru; nosi samo ko je koga preporučio i kada — bez teksta i ocene.
/// Drugima se prikazuje samo BROJ; ko je preporučio ne vidi niko osim onoga ko je
/// preporuku dao. Preporuka ne proizvodi POEN i ne utiče na pristup.
model Preporuka {
  id        String   @id @default(uuid())
  odId      String
  od        User     @relation("PreporukaOd", fields: [odId], references: [id], onDelete: Cascade)
  zaId      String
  za        User     @relation("PreporukaZa", fields: [zaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([odId, zaId])
  @@index([zaId])
}

/// Dnevni snimak pokazatelja zdravlja i koncentracije (`/sistem/zdravlje`; odluke
/// vlasnika 25.10.2026). 🔴 Bez ijednog identifikatora lica: samo šifra pokazatelja,
/// vrednost i lampica (`{ "K1": { "v": 63.4, "l": "CRVENO" }, … }`). Upisuje ga noćni
/// obračun; ne proizvodi nikakvo dejstvo.
model PokazateljDan {
  date      DateTime @id @db.Date
  vrednosti Json
  createdAt DateTime @default(now())
}

model DailyEmissionSummary {
  id             String   @id @default(uuid())
  date           DateTime @unique @db.Date
  opticaj        Int
  limit          Int
  totalRequested Int
  totalEmitted   Int
  koeficijent    Decimal  @db.Decimal(10, 6)
  breakdown      Json
  createdAt      DateTime @default(now())
}

// ─── Program Doprinosa Zajedničkom Dobru — Oglasi ─────────────────────────────

model DoprinosOglas {
  id                         String               @id @default(uuid())
  title                      String
  description                String
  source                     OglasSource
  predlozeniPoen             Int // predloženi POEN za potpuno izvršenje (čl. 5/6) — težinski koeficijent, nije garantovan iznos; 0 = bez ograničenja zbira dnevnih izvršenja
  obrazlozenje               String? // obrazloženje predloženog POEN-a (čl. 6)
  saOdobravanjem             Boolean              @default(false) // čl. 12 — prijava primljena tek po izričitom odobrenju plana izvršenja
  procenaObima               String? // procena obima rada (čl. 5) — opisno, ne sati × iznos; NULL kod zatečenih zadataka
  opisCeline                 String? // šta je jedna celina — deo posla, ne vreme (čl. 5, 6; S1)
  brojCelina                 Int? // broj celina; predlozeniPoen = POEN po celini × brojCelina; NULL = zatečen zadatak (staro pravilo)
  positions                  Int                  @default(1)
  deadline                   DateTime? // rok za prijavu
  rokIzvrsenja               DateTime? // rok za izvršenje (operativni 5.0 čl. 5 t. 7); NULL kod zatečenih zadataka
  /// Kvalifikacioni filter (čl. 5 t. 10, čl. 9 st. 3) i njegovo obrazloženje — oba ili nijedno.
  kvalifikacioniUslov        String?
  kvalifikacioniObrazlozenje String?
  /// Obrazloženje odluke UO kojom je zadatak posle objave prebačen u režim odobravanja (čl. 12 st. 2).
  odobravanjeObrazlozenje    String?
  /// Povlačenje zadatka (čl. 8): obrazloženje je javno kad je zadatak u izvršenju.
  povucenoAt                 DateTime?
  povucenoObrazlozenje       String?
  /// Privremena obustava potvrde i raspodele odlukom UO dok se ne odluči o primedbi (čl. 18 st. 2).
  obustavljenoAt             DateTime?
  obustavaObrazlozenje       String?
  /// Zadružni doprinos (operativni čl. 23; zadruge čl. 17): celina u zadruzi `krugId`,
  /// izvršioca određuje zadruga (bez prijave), potvrđuje samo čuvar Kola.
  zadruzni                   Boolean              @default(false)
  status                     OglasStatus          @default(ACTIVE)
  createdById                String
  createdBy                  User                 @relation("KreiraniOglasi", fields: [createdById], references: [id])
  krugId                     String?
  krug                       Krug?                @relation("KrugOglasi", fields: [krugId], references: [id])
  prijave                    OglasPrijava[]
  evidencije                 OglasEvidencija[]
  primedbe                   OperativnaPrimedba[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model OglasPrijava {
  id                  String               @id @default(uuid())
  oglasId             String
  oglas               DoprinosOglas        @relation(fields: [oglasId], references: [id])
  userId              String
  user                User                 @relation("OglasPrijave", fields: [userId], references: [id])
  planIzvrsenja       String? // plan izvršenja (čl. 10) — obavezan uz svaku prijavu
  // Izjava izvršioca o pravnoj prirodi operativnog doprinosa (čl. 10 st. 1 t. 3).
  // Tekst se SNIMA i posle toga se ne menja — dokument mora da govori ono što je
  // govorio u trenutku prijave. Zatečene prijave ostaju bez izjave (null): za njih
  // izjava nije ni data, a retroaktivno „data" izjava bila bi netačan dokument.
  izjavaTekst         String?
  izjavaAt            DateTime?
  status              OglasPrijavaStatus   @default(PENDING)
  approvedById        String?
  approvedAt          DateTime?
  rejectionReason     String?
  /// `oglasId:userId` dok je prijava živa (na čekanju ili primljena, bez odustanka); NULL
  /// posle odbijanja i odustanka, pa podnosilac sme da podnese izmenjenu prijavu (čl. 12 st. 4).
  aktivanKljuc        String?              @unique
  /// Kako podnosilac ispunjava kvalifikacioni filter (čl. 9 st. 3, 11 st. 2), kad ga zadatak ima.
  ispunjenostUslova   String?
  /// Odustanak izvršioca (čl. 17) — elektronska izjava, bez obrazloženja.
  odustaoAt           DateTime?
  /// Prijava završetka (čl. 16 st. 1) i završna odluka lica koje potvrđuje (st. 2).
  zavrsetakAt         DateTime?
  zavrsnaOdluka       ZavrsnaOdluka?
  zavrsnaOdlukaAt     DateTime?
  zavrsnaOdlukaById   String?
  zavrsnoObrazlozenje String?
  /// Zadružni doprinos (operativni čl. 23 st. 2): lice koje je izvršiocu dodelilo celinu u ime zadruge.
  dodelioId           String?
  evidencije          OglasEvidencija[]
  primedbe            OperativnaPrimedba[]
  createdAt           DateTime             @default(now())

  @@index([oglasId, userId])
  @@index([status, oglasId])
}

/// Završna odluka o izvršenju zadatka (operativni 5.0 čl. 16 st. 2).
enum ZavrsnaOdluka {
  IZVRSEN
  DELIMICNO
  ODBIJEN
}

/// Primedba učesnika na prijavu, plan, potvrdu celina ili završnu potvrdu (operativni
/// 5.0 čl. 18). Dostupna svim učesnicima, bez pseudonima podnosioca; lice koje
/// potvrđuje se izjašnjava u roku od 7 dana.
model OperativnaPrimedba {
  id           String           @id @default(uuid())
  oglasId      String
  oglas        DoprinosOglas    @relation(fields: [oglasId], references: [id])
  prijavaId    String?
  prijava      OglasPrijava?    @relation(fields: [prijavaId], references: [id])
  evidencijaId String?
  evidencija   OglasEvidencija? @relation(fields: [evidencijaId], references: [id])
  /// PRIJAVA | IZVRSENJE_CELINA | ZAVRSNA (`PREDMETI_PRIMEDBE` u operativni-pravila.ts)
  predmet      String
  autorId      String
  tekst        String
  odluka       String?
  odlukaAt     DateTime?
  odlukaById   String?
  createdAt    DateTime         @default(now())

  @@index([oglasId, createdAt])
}

/// Lice koje Upravni odbor ovlasti da potvrđuje izvršenje operativnog doprinosa
/// (operativni 5.0 čl. 13 st. 1; Pravilnik čl. 34 st. 1). Upisuje superadmin po
/// odluci UO; `izuzetakPredlagaca` je izričito ovlašćenje iz čl. 13 st. 4 da
/// potvrđuje i zadatke koje je Fondacija objavila preko njega.
model OperativnoOvlascenje {
  id                 String    @id @default(uuid())
  userId             String    @unique
  odluka             String
  izuzetakPredlagaca Boolean   @default(false)
  upisaoId           String
  createdAt          DateTime  @default(now())
  opozvanoAt         DateTime?
}

/// Operativni parametar koji Upravni odbor utvrđuje odlukom (npr. iznos jedinice
/// zadružnog doprinosa, operativni čl. 23 st. 4; prag za režim odobravanja, čl. 12
/// st. 1 t. 3). 🔴 Bez podrazumevane vrednosti: dok red ne postoji, parametar nije
/// utvrđen. Istorija se ne prepravlja — izmena je nov red sa `vaziOd`.
model OdlukaParametra {
  id        String   @id @default(uuid())
  kljuc     String
  vrednost  Int
  vaziOd    DateTime @db.Date
  odluka    String
  upisaoId  String
  createdAt DateTime @default(now())

  @@index([kljuc, vaziOd])
}

model OglasEvidencija {
  id                 String               @id @default(uuid())
  userId             String
  user               User                 @relation("OglasEvidencije", fields: [userId], references: [id])
  oglasId            String
  oglas              DoprinosOglas        @relation(fields: [oglasId], references: [id])
  prijavaId          String
  prijava            OglasPrijava         @relation(fields: [prijavaId], references: [id])
  date               DateTime             @db.Date // dan na koji se odnosi izvršenje
  predlozeniPoen     Int // predloženi POEN za ovo dnevno izvršenje (čl. 15) — težina u raspodeli
  celina             Int? // broj izvršenih celina (čl. 15, S1); predlozeniPoen = celina × POEN po celini; NULL kod zatečenih
  amount             Int                  @default(0) // evidentirani POEN nakon noćne raspodele (čl. 21); 0 dok nije obračunato
  dokaz              String? // link/opis dokaza izvršenja (čl. 15)
  description        String
  status             EvidencijaStatus     @default(PENDING) // PENDING→APPROVED (potvrđeno, ulazi u raspodelu)→EMITTED / REJECTED; DOPUNA = uslovno potvrđeno, čeka dopunu dokaza (čl. 15 st. 2 t. 3)
  approvedById       String?
  approvedAt         DateTime?
  /// Obrazloženje odbijanja, odnosno šta se traži kao dopuna dokaza (čl. 15 st. 2 t. 2–3).
  odlukaObrazlozenje String?
  /// Kada je izvršilac dopunio dokaz posle uslovne potvrde; od tada teče novi rok od 3 dana.
  dopunaAt           DateTime?
  /// Red nastao završnom potvrdom (čl. 16 st. 2) za celine koje do tada nisu potvrđene.
  zavrsna            Boolean              @default(false)
  /// Zadružni doprinos: deo predloženog POEN-a koji ne ulazi u raspodelu jer prelazi
  /// najveći dnevni iznos zadruge (zadruge čl. 17 st. 3; operativni čl. 23 st. 3).
  visakZadruge       Int?
  primedbe           OperativnaPrimedba[]
  createdAt          DateTime             @default(now())

  @@unique([userId, oglasId, date, zavrsna])
  @@index([date, status])
  @@index([status])
}

// ─── ZRNO sistem ─────────────────────────────────────────────────────────────

/// Prekidač kanala upisa i otpisa ZRNA (Pravilnik čl. 22, 23; faza-sistema.ts).
/// 🔴 Model se do 13.09.2026. zvao `ZrnoTrziste` — ime je uklonjeno uz R-04, jer
/// Pravilnik čl. 24 izričito kaže da za ZRNO tržište ne postoji. Repo je
/// javan pod AGPL-om, pa je šema prvo mesto koje se čita; ime modela ne sme da
/// govori suprotno od akta. Ne vraćati „tržište" ni u jedan identifikator.
model ZrnoKanal {
  id          String    @id @default("singleton")
  isActive    Boolean   @default(false)
  activatedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model ZrnoStanje {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  slobodno  Int      @default(0)
  aktivno   Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// 🔴 Polja su se do 13.09.2026. zvala `zrnaKupljeno` i `poenPlaceno` — uklonjeno
/// uz R-04. ZRNO se ne kupuje i POEN se ne plaća: upisom se evidentirani doprinos
/// korisnika umanjuje prema obračunskom koeficijentu (Pravilnik čl. 22 st. 5).
model ZrnoUpisZahtev {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  poenIznos    Int
  date         DateTime         @db.Date
  status       ZrnoZahtevStatus @default(PENDING)
  zrnaUpisana  Int?
  utrosenoPoen Int?
  createdAt    DateTime         @default(now())

  @@unique([userId, date])
  @@index([date, status])
}

/// Pri otpisu Protokol evidentira POEN-e nosiocu (Pravilnik čl. 23 st. 3) — otud
/// `evidentiranoPoen`; polje se do 13.09.2026. zvalo `poenDobijeno`.
model ZrnoOtpisZahtev {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  kolicina         Int
  date             DateTime         @db.Date
  status           ZrnoZahtevStatus @default(PENDING)
  evidentiranoPoen Int?
  createdAt        DateTime         @default(now())

  @@unique([userId, date])
  @@index([date, status])
}

model ZrnoStatusZahtev {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  kolicina  Int
  akcija    ZrnoStatusAkcija
  date      DateTime         @db.Date
  status    ZrnoZahtevStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([date, status])
}

/// Dnevni snimak obračunskog koeficijenta (Pravilnik čl. 25, 26).
/// 🔴 Model se do 13.09.2026. zvao `ZrnoDailyRate`, a polje `kurs` — oba imena su
/// uklonjena uz R-04. Čl. 25 st. 4: koeficijent „nije cena, nije kurs i nije
/// indeks performansi".
/// 🟢 Snimak se NE briše: on je dokaz da koeficijent izračunava Protokol
/// automatski i bez diskrecije (čl. 25 st. 1). Menja se ime, ne postojanje.
model ZrnoDnevniKoeficijent {
  date           DateTime @unique @db.Date
  koeficijent    Decimal  @db.Decimal(20, 2)
  protokolMinus  Int
  zrnaUProtokolu Int
  createdAt      DateTime @default(now())
}

model ZrnoDelegacija {
  id                String   @id @default(uuid())
  delegatorId       String   @unique
  delegator         User     @relation("Delegator", fields: [delegatorId], references: [id])
  delegatId         String?
  delegat           User?    @relation("Delegat", fields: [delegatId], references: [id])
  zakazaniDelegatId String?
  zakazaniDelegat   User?    @relation("ZakazaniDelegat", fields: [zakazaniDelegatId], references: [id])
  imaZakazano       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── Glasanje ─────────────────────────────────────────────────────────────────

model GlasanjePredlog {
  id                    String            @id @default(uuid())
  title                 String
  description           String
  authorId              String
  author                User              @relation(fields: [authorId], references: [id])
  vrsta                 PredlogVrsta      @default(ODLUKA) // odluka (obavezujuća) ili dinarska preporuka (Gornje Kolo čl. 6 st. 1)
  glasanjePocetak       DateTime // ponoć narednog obračunskog perioda (čl. 11)
  deadline              DateTime // kraj glasanja = kraj tog perioda
  status                PredlogStatus     @default(ACTIVE)
  ishodUsvojen          Boolean? // utvrđen po zatvaranju, prosta većina (Gornje Kolo čl. 7, 19)
  zaZbir                Int? // zbir glasačke moći „za" u trenutku zatvaranja
  protivZbir            Int? // zbir glasačke moći „protiv" u trenutku zatvaranja
  izvrsenjeStatus       IzvrsenjeStatus? // postavlja se na ZA_IZVRSENJE kad je odluka usvojena (čl. 17)
  vetoObrazlozenje      String? // obavezno obrazloženje zaštitnog veta (veto ukinut u setu 5.0; polje ostaje kao istorija)
  izvrsenjeAkt          String? // oznaka akta UO kojim je odluka sprovedena (Pravilnik čl. 46 st. 2) — bez njega registar ne pokazuje da je nadležni organ išta doneo
  odbijanjeRazlog       OdbijanjeRazlog? // razlog sa zatvorene liste iz Pravilnika čl. 46 st. 3
  odbijanjeObrazlozenje String? // obavezno obrazloženje odbijanja (Pravilnik čl. 46 st. 4)
  odbijanjeAt           DateTime?
  izvrsenoAt            DateTime?
  vetoAt                DateTime?
  uoOdgovor             UoOdgovor? // obrazložen odgovor UO na usvojenu preporuku (Gornje Kolo čl. 18)
  uoObrazlozenje        String?
  uoOdgovorAt           DateTime?
  /// Početak perioda podrške (Pravilnik o Gornjem Kolu čl. 10 st. 1): obračunski period
  /// posle podnošenja. Null = postupak bez faze podrške (izborno glasanje koje pokreće
  /// Fondacija po pravilniku o nabavkama; predlozi zatečeni pre seta 5.0).
  podrskaPocetak        DateTime?
  /// Zašto se o predlogu nije glasalo (GK čl. 10 st. 3–4, 19 st. 1). Null = glasalo se.
  neglasanjeRazlog      NeglasanjeRazlog?
  podrske               GlasanjePodrska[]
  glasovi               GlasanjeGlas[]
  nabavka               Nabavka?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model GlasanjeGlas {
  id              String          @id @default(uuid())
  predlogId       String
  predlog         GlasanjePredlog @relation(fields: [predlogId], references: [id])
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  /// Za/protiv glasanje (ODLUKA, DINARSKA_PREPORUKA). Null pri izbornom glasanju.
  za              Boolean?
  /// Izborno glasanje (IZBOR_NABAVKE): id naziva dobra za koji je glas dat.
  /// Null pri za/protiv glasanju. Tačno jedno od `za` i `izbor` je popunjeno.
  izbor           String?
  glasackaGlasova Int
  createdAt       DateTime        @default(now())

  @@unique([predlogId, userId])
  @@index([predlogId])
}

/// Podrška čuvara Kola predlogu (Pravilnik o Gornjem Kolu čl. 10). Podrška nije glas,
/// ne nosi glasačku moć i ne delegira se. `podnosenjem` = predlog je podneo čuvar Kola
/// u sastavu Gornjeg Kola, pa se smatra podržanim njegovim podnošenjem (čl. 10 st. 1).
model GlasanjePodrska {
  id          String          @id @default(uuid())
  predlogId   String
  predlog     GlasanjePredlog @relation(fields: [predlogId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  podnosenjem Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@unique([predlogId, userId])
  @@index([predlogId])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])
  akcija    String
  targetId  String?
  detalji   String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// Dnevnik aktivnosti prijavljenih korisnika: koja stranica je otvorena i kada.
// Beleži se SAMO za prijavljene korisnike (gosti nikad); ponovna poseta iste
// stranice unutar 5 min se ne duplira. Retencija 12 meseci (GDPR cron —
// „tehnički logovi", Politika čl. 41). Vidljivo isključivo superadminu.
model AktivnostLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  putanja   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model DonationRecord {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  amountRSD       Decimal        @db.Decimal(12, 2)
  cumulativeRSD   Decimal        @db.Decimal(12, 2)
  level           Int
  poenEmitted     Int
  status          DonationStatus @default(PENDING)
  referenceNumber String?
  confirmedAt     DateTime?
  confirmedById   String?
  createdAt       DateTime       @default(now())

  // Kartično plaćanje (NestPay: Banca Intesa / OTP). RUCNO = klasična uplata
  // na račun koju admin ručno potvrđuje. KARTICA = naplata preko gateway-a.
  nacinUplate String  @default("RUCNO")
  provajder   String?
  oid         String? @unique
  bankRef     String?

  // Javna vs anonimna donacija (Pravilnik o pokroviteljstvu i donacijama, čl. 7
  // i 11). Javna donacija (true) → ime i prezime donatora vidljivi u listi donacija
  // i evidentira se POEN. Anonimna (false) → bez imena i BEZ POEN-a.
  javno Boolean @default(true)

  // Ime i prezime donatora SNIMLJENO u trenutku evidentiranja javne donacije —
  // trajan zapis (kao i podaci o uplati), nezavisan od kasnijih izmena profila.
  // Lista donacija prikazuje upravo ovo polje. Null = anonimna ili istorijska
  // donacija (pre uvođenja pravila) → ne prikazuje se u listi.
  // 🔴 Od seta 4.6.8 ime NIJE trajno: donator sme da povuče pristanak (donacije
  // čl. 12), a briše se i prestankom svojstva korisnika. Tada se `donatorIme`
  // briše, a `imePovucenoAt` beleži trenutak — donacija ostaje u listi iznosom
  // i datumom (pseudonim se u listi ne prikazuje).
  donatorIme String?

  // Trenutak kada je ime uklonjeno iz liste (povlačenje ili gašenje naloga).
  // Null = ime nikad nije povučeno (ili anonimna/istorijska donacija).
  imePovucenoAt DateTime?

  // Ugovor o donaciji (Pravilnik o pokroviteljstvu i donacijama, cl. 5b) —
  // SNIMLJEN tekst u trenutku potvrde donacije. Ne generise se ponovo pri
  // citanju: dokument mora da govori ono sto je govorio kad je donacija
  // primljena, bez obzira na kasnije izmene pravilnika. Null = istorijska
  // donacija (pre uvodjenja ugovora).
  ugovorTekst String?

  // Ime uplatioca iz bankovnog izvoda (Pravilnik o pokroviteljstvu i donacijama
  // cl. 3 i glava IV). Doprinos se evidentira ISKLJUCIVO korisniku cijim je
  // sredstvima uplata izvrsena; ovo polje je trag da je to provereno. Trazi se
  // pri rucnoj evidenciji i potvrdi priliva iz izvoda; kod karticnog placanja
  // upisuje se ime samog korisnika, jer akt trazi da kartica glasi na njega.
  // Null = istorijska donacija (pre uvodjenja pravila).
  uplatilac String?

  // Uplata sa racuna otvorenog u inostranstvu (cl. 13b t. 4) — evidentira se
  // pošto UO utvrdi identitet donatora i osnov uplate. Oznaka sluzi izvestavanju.
  straniPriliv Boolean @default(false)

  // Normalizovan ključ uplatioca (mera C-1 uz R-01) — mala slova, bez dijakritike,
  // reči sortirane, pa se "Petar Petrović" i "PETROVIĆ PETAR" poklapaju. Sluzi
  // ISKLJUČIVO poređenju: dva naloga sa uplatama istog uplatioca su isti čovek,
  // što zaustavlja evidentiranje do ljudske odluke. Null = istorijska donacija.
  uplatilacKljuc String?

  // Kvačica pre kartične naplate (mera M-11): donator je potvrdio da je donacija
  // nepovratna i da njome ne dobija robu ni uslugu. Snima se na zapis kao dokaz
  // u sporu po osporenoj transakciji. Null = nije kartični tok ili istorijski zapis.
  nepovratnostPotvrdjenaAt DateTime?

  @@index([status, createdAt])
  @@index([uplatilacKljuc])
}

// ─── Pokrovitelji ─────────────────────────────────────────────────────────────

model Pokrovitelj {
  id             String                    @id @default(uuid())
  naziv          String
  /// Ključ novčanog pokrovitelja: pravno lice i preduzetnik po PIB-u, registrovano
  /// poljoprivredno gazdinstvo po BPG-u (donacije čl. 15 i 22, set 4.7.9). Tačno
  /// jedno od dva je upisano; kumulativ gazdinstva je zaseban red — ne sabira se ni
  /// sa ličnim donacijama nosioca ni sa firmom (čl. 22 st. 3).
  pib            String?                   @unique
  bpg            String?                   @unique
  maticniBroj    String?
  /// Adresa sedišta. Ne objavljuje se na ranglisti (donacije čl. 25 st. 2) — preduzetniku je
  /// to često kućna adresa.
  adresa         String?
  kontaktEmail   String?
  kontaktTelefon String?
  vlasnikId      String
  vlasnik        User                      @relation("VlasnikP", fields: [vlasnikId], references: [id])
  kreiraoId      String
  kreirao        User                      @relation("AdminKreiraoP", fields: [kreiraoId], references: [id])
  /// Logotip pokrovitelja (donacije čl. 26 st. 2): javni URL slike na R2, deo
  /// evidencije pokrovitelja (naziv i logotip). Objavljuje se uz naziv na
  /// rang-listi — najnoviji iz potvrđene prijave. 🔴 Bez veze ka internet stranici
  /// pokrovitelja (čl. 26 st. 3). Moderacija ga samo uklanja, nikad ne menja.
  logoUrl        String?
  rsdKumulativ   Decimal                   @default(0) @db.Decimal(12, 2)
  trenutniNivo   Int                       @default(0)
  /// Upis u evidenciju pokrovitelja (donacije čl. 16) — odatle se čitaju naziv i
  /// logotip za rang-listu. Zatečeni redovi su povezani migracijom po PIB-u.
  upisId         String?
  upis           UpisPokrovitelja?         @relation(fields: [upisId], references: [id])
  status         String                    @default("ACTIVE") // ACTIVE | SUSPENDED
  doprinosi      PokroviteljDoprinos[]
  bonusiEmisije  PokroviteljBonusEmisija[]
  prijave        PokroviteljPrijava[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([vlasnikId])
  @@index([status])
}

// Prijava pokroviteljstva (donacije čl. 19–21) — verifikovani korisnik pokreće evidenciju
// doprinosa pravnog lica; platforma generiše ugovor; po potvrdi Fondacije emituje
// se bonus POEN prema nivoima (čl. 22).
model PokroviteljPrijava {
  id                  String                   @id @default(uuid())
  podnosilacId        String
  podnosilac          User                     @relation("PodnosilacPrijave", fields: [podnosilacId], references: [id])
  /// FIRMA (pravno lice, preduzetnik) ili GAZDINSTVO (nosilac registrovanog
  /// poljoprivrednog gazdinstva, donacije čl. 15, set 4.7.9). Zatečene prijave: FIRMA.
  vrstaDavaoca        VrstaDavaoca             @default(FIRMA)
  naziv               String
  /// PIB — samo FIRMA; gazdinstvo umesto njega nosi `bpg`.
  pib                 String?
  bpg                 String?
  /// Matični broj i adresa sedišta (Pravilnik o pokroviteljstvu i donacijama
  /// čl. 16 st. 2 t. 1, set 4.7.5). Zatečene prijave ostaju `null`.
  maticniBroj         String?
  adresaSedista       String?
  /// Zastupnik koji podnosi prijavu — ime i prezime ide i u evidenciju
  /// identiteta (Pravilnik čl. 31 st. 2; donacije čl. 19 st. 3) pri potvrdi prijema; ne
  /// prikazuje se drugim korisnicima.
  zastupnikImePrezime String?
  zastupnikFunkcija   String?
  /// Fondacija pre potvrde upoređuje naziv, MB i zastupnika sa podacima APR-a;
  /// beleži se samo da je poređenje izvršeno (Pravilnik čl. 31 st. 4).
  aprUporedjenAt      DateTime?
  aprUporedioId       String?
  vrstaDonacije       VrstaDonacije
  vrednostRsd         Decimal                  @db.Decimal(12, 2)
  cenovnikSlika       String?
  /// Logotip iz prijave (donacije čl. 26 st. 2) — pri potvrdi prelazi na red
  /// `Pokrovitelj`. Nije obavezan.
  logoUrl             String?
  ugovorTekst         String
  status              PokroviteljPrijavaStatus @default(CEKA_POTPIS)
  potpisanoAt         DateTime?
  /// Potpis jednokratnim kodom (donacije čl. 20 st. 1 → čl. 32 st. 1; registar
  /// 2026-10, F5-M1): kontrolni broj snimljenog teksta i heš koda sa rokom i brojem
  /// pokušaja. Posle potpisa se heš briše. 🔴 Bez IP adrese i podataka o uređaju.
  /// Prijave potpisane pre ove izmene (jednim klikom) ostaju bez kontrolnog broja.
  kontrolniBroj       String?
  potpisKodHash       String?
  potpisKodIstice     DateTime?
  potpisKodPokusaja   Int                      @default(0)
  potpisKodPoslatAt   DateTime?
  pokroviteljId       String?
  pokrovitelj         Pokrovitelj?             @relation(fields: [pokroviteljId], references: [id])
  /// Upis iz koga je prijava podneta (donacije čl. 18 st. 3, čl. 19 st. 1). Podaci o
  /// pokrovitelju gore su SNIMAK upisa u trenutku podnošenja (ugovor je snimljen).
  upisId              String?
  upis                UpisPokrovitelja?        @relation(fields: [upisId], references: [id])
  potvrdioId          String?
  potvrdjenoAt        DateTime?
  odbijenoRazlog      String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([podnosilacId])
  @@index([status])
}

// ─── Pokroviteljstvo dobrima i uslugama (donacije Glava IV) ─────────────────
//
// Jedan red = prijava, pa ugovor (ugovor u korist trećih lica, ZOO čl. 149). Fondacija
// ne stiče svojinu ni državinu dobara; vaučer glasi na tačno određeno dobro odnosno
// uslugu, NE na iznos (donacije čl. 27, 29).
//
// 🔴 Vrednost ugovora NE ulazi u `Pokrovitelj.rsdKumulativ` i ne utiče na nivo ni na
// rang-listu (donacije čl. 33 st. 3, čl. 25 st. 1). Zato ovaj model ne pravi red `Pokrovitelj`
// — samo čita kumulativ novčanog doprinosa po PIB-u, odnosno BPG-u gazdinstva, ako ga ima.
model UgovorDobra {
  id                        String                 @id @default(uuid())
  /// Upis iz koga je prijava podneta (donacije čl. 18 st. 3, čl. 28 st. 1). Podaci o
  /// davaocu ispod su SNIMAK upisa u trenutku podnošenja.
  upisId                    String?
  upis                      UpisPokrovitelja?      @relation(fields: [upisId], references: [id])
  podnosilacId              String
  podnosilac                User                   @relation("PodnosilacUgovoraDobra", fields: [podnosilacId], references: [id])
  /// FIRMA (pravno lice, preduzetnik) ili GAZDINSTVO (nosilac registrovanog
  /// poljoprivrednog gazdinstva, čl. 28 st. 1).
  vrstaDavaoca              VrstaDavaoca           @default(FIRMA)
  /// Naziv pravnog lica ili preduzetnika, odnosno naziv gazdinstva.
  naziv                     String
  /// PIB, matični broj i sedište — samo FIRMA. Gazdinstvo umesto njih navodi broj
  /// gazdinstva (čl. 16 st. 4).
  pib                       String?
  maticniBroj               String?
  adresaSedista             String?
  /// Broj poljoprivrednog gazdinstva (BPG) — samo GAZDINSTVO. Po njemu se gazdinstvo
  /// prepoznaje za kvotu (čl. 29 st. 4) i zabranu posle raskida (čl. 35 st. 5).
  bpg                       String?
  /// Ime i prezime podnosioca (zastupnika, preduzetnika, vlasnika, stvarnog vlasnika,
  /// odnosno nosioca gazdinstva) ide u evidenciju identiteta pri potpisu (donacije čl. 28 st. 4,
  /// Pravilnik čl. 31). `zastupnikFunkcija` nosi funkciju zastupnika, odnosno opis odnosa.
  zastupnikImePrezime       String
  zastupnikFunkcija         String
  /// Odnos podnosioca prema davaocu (čl. 16 st. 2 t. 4). Zatečeni redovi ostaju `null`.
  odnosPremaDavaocu         OdnosPremaDavaocu?
  /// Kontakt sa davaocem (čl. 16 st. 2 t. 2): primerak zaključenog ugovora ide na ovaj mejl.
  kontaktEmail              String?
  kontaktTelefon            String?
  /// Izjava o ovlašćenju (čl. 17 st. 1) — kad podnosilac nije zakonski zastupnik,
  /// preduzetnik ni nosilac gazdinstva.
  izjavaOvlascenjeAt        DateTime?
  /// Potvrda da je podnosilac upoznat sa načinom evidentiranja doprinosa (čl. 17
  /// st. 2): trenutak i SNIMAK teksta koji mu je bio prikazan.
  potvrdaEvidentiranjaAt    DateTime?
  potvrdaEvidentiranjaTekst String?
  /// Kontrolni broj teksta zaključenog ugovora (SHA-256 snimljenog teksta, čl. 32
  /// st. 1). 🔴 Uz potpis se NE beleže IP adresa ni podaci o uređaju.
  kontrolniBroj             String?
  /// Jednokratni kod za potpis (čl. 32 st. 1): čuva se samo heš, uz rok i broj
  /// pokušaja. Posle potpisa se briše.
  potpisKodHash             String?
  potpisKodIstice           DateTime?
  potpisKodPokusaja         Int                    @default(0)
  potpisKodPoslatAt         DateTime?
  vrsta                     VrstaDobraPokrovitelja
  opis                      String
  brojVaucera               Int
  cenaPoJedinici            Decimal                @db.Decimal(12, 2)
  /// brojVaucera × cenaPoJedinici (čl. 29 st. 1). Snima se pri prijavi.
  vrednostRsd               Decimal                @db.Decimal(12, 2)
  /// Rok važenja u mesecima od izdavanja — jedna godina (čl. 29 st. 5).
  rokVazenjaMeseci          Int
  /// Naselje iz šifarnika (`razresiNaselje`).
  mesto                     String
  /// Slobodan opis mesta predaje (ulica, radnja) — prikazuje se na vaučeru.
  adresaPredaje             String?
  /// Logotip davaoca (donacije čl. 26 st. 2): uz naziv na rang-listi „Dobra i
  /// usluge", na vaučerima i uz ponudu vaučera. Nije obavezan; javni URL na R2.
  /// 🔴 Bez veze ka internet stranici davaoca (čl. 26 st. 3).
  logoUrl                   String?
  /// Napušteno (set 4.7.8, 20.10.2026): kapacitet se više ne traži. Kolona ostaje
  /// zbog zatečenih redova; kod je ne čita.
  nedeljniKapacitet         Int?
  /// Izjava o propisima za promet (čl. 28 st. 3) — trenutak davanja izjave.
  izjavaPropisiAt           DateTime
  status                    UgovorDobraStatus      @default(NA_PREGLEDU)
  odbijenoRazlog            String?
  pregledaoId               String?
  pregledanoAt              DateTime?
  /// `aprUporedjenAt`: podaci o davaocu upoređeni sa registrom (čl. 18 st. 1; beleži se samo da je
  /// poređenje izvršeno). `cenaUporedjenaAt`: samo zatečeni redovi — od seta 5.0 cena se ne
  /// upoređuje (čl. 29 st. 2: Fondacija proverava samo da je fotografija cenovnika priložena).
  aprUporedjenAt            DateTime?
  cenaUporedjenaAt          DateTime?
  /// 🔴 Snimljen tekst ugovora (čl. 31 st. 1) — ne generiše se ponovo pri čitanju.
  ugovorTekst               String?
  potpisanoAt               DateTime?
  vaziDo                    DateTime?
  /// Snimci pri potpisu: koeficijent iz NOVČANOG kumulativa (čl. 33 st. 2) i broj
  /// evidentiranih POEN-a. Otpis po neizvršenju čita ove snimke, ne računa ponovo.
  koeficijent               Decimal?               @db.Decimal(4, 2)
  poenEvidentirano          Int?
  emisijaTxId               String?
  // 🔴 Napušteno (set 4.7.8, 20.10.2026): raspodele u krugovima nema — vaučeri se
  // uzimaju slobodno od izdavanja (nabavke čl. 32 st. 2). Kolone krugova ostaju zbog
  // zatečenih redova; kod ih ne čita.
  raspodelaKrug             Int                    @default(0)
  /// Broj POEN-a po vaučeru (nabavke čl. 31) — snima se pri potpisu.
  poenaPoVauceru            Int?
  raspodelaObjavljenaAt     DateTime?
  rokPrijaveRaspodele       DateTime?
  raspodelaDodeljenaAt      DateTime?
  // Raskid po neizvršenju (donacije čl. 35).
  raskinutoAt               DateTime?
  raskidObrazlozenje        String?
  raskinuoId                String?
  /// Ukupan otpis podnosiocu pri raskidu (otpis po vaučeru × broj vaučera u raskidu).
  raskidOtpis               Int?
  raskidOtpisTxId           String?
  /// Odluka Fondacije da davalac sme da zaključi naredni ugovor iako nije
  /// iskorišćena polovina vaučera ovog ugovora (čl. 29 st. 4, set 4.8.4; N2-M6).
  /// Samo superadmin, obrazloženje obavezno.
  naredniDozvoljenAt        DateTime?
  naredniDozvolioId         String?
  naredniDozvolaRazlog      String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  dokazi  DokazCeneDobra[]
  izvori  IzvorCeneDobra[]
  vauceri Vaucer[]
  prijave PrijavaRaspodele[]
  zabrane ZabranaDavaoca[]

  @@index([podnosilacId])
  @@index([upisId, status])
  @@index([maticniBroj, createdAt(sort: Desc)])
  @@index([bpg, createdAt(sort: Desc)])
  @@index([status])
  @@index([status, raskinutoAt])
}

/// Dokaz cene: SAMO fotografija cenovnika (donacije čl. 28 st. 2 t. 4, čl. 29 st. 2). 🔴 Čuva se u bazi, a
/// ne na javnom R2 skladištu: vidi ga SAMO administratorski tim (ruta pod
/// `/api/admin/`), nikad javnost ni drugi korisnici.
model DokazCeneDobra {
  id          String      @id @default(uuid())
  ugovorId    String
  ugovor      UgovorDobra @relation(fields: [ugovorId], references: [id], onDelete: Cascade)
  /// CENOVNIK. Vrednosti RACUN, POTVRDA_RPG i SNIMAK_IZVORA nose samo zatečeni redovi (do
  /// seta 5.0); ruta ih više ne prima (`proveriDokaze`).
  vrsta       String
  /// Samo zatečeni redovi SNIMAK_IZVORA: redni broj izvora cene (`IzvorCeneDobra.redniBroj`).
  izvorRedni  Int?
  nazivFajla  String
  contentType String
  velicina    Int
  sadrzaj     Bytes
  createdAt   DateTime    @default(now())

  @@index([ugovorId])
}

/// Vaučer (donacije čl. 2, čl. 27). Imenski i neprenosiv; ne glasi na iznos.
model Vaucer {
  id                   String       @id @default(uuid())
  ugovorId             String
  ugovor               UgovorDobra  @relation(fields: [ugovorId], references: [id])
  kod                  String       @unique
  status               VaucerStatus @default(SLOBODAN)
  imalacId             String?
  imalac               User?        @relation("ImalacVaucera", fields: [imalacId], references: [id])
  dodeljenAt           DateTime?
  /// 🔴 Napušteno (set 4.7.8, odluka 20.10.2026): vaučeri se više ne rezervišu, POEN
  /// se poništava pri dodeli. Kolona ostaje zbog zatečenih redova; kod je ne čita.
  rezervisano          Int          @default(0)
  /// Snimak broja POEN-a poništenog pri DODELI (nabavke čl. 33 st. 4) — za ispravku po
  /// nabavke čl. 35 i Pravilniku čl. 18 st. 5.
  ponisteno            Int          @default(0)
  iskoriscenAt         DateTime?
  ponistenjeTxId       String?
  /// Ko je potvrdio realizaciju (nabavke čl. 34 st. 1): podnosilac ili zaposleni
  /// davaoca. Za potvrdu zaposlenog odgovara davalac. Zatečeni redovi ostaju `null`.
  potvrdioId           String?
  potvrdio             User?        @relation("PotvrdilacVaucera", fields: [potvrdioId], references: [id], onDelete: SetNull)
  istekaoAt            DateTime?
  neizvrsenAt          DateTime?
  ispravkaTxId         String?
  otpisTxId            String?
  otpisano             Int?
  /// Izjava „nisam povezano lice sa davaocem" pri uzimanju (donacije čl. 36).
  izjavaNepovezanAt    DateTime?
  /// Pristanak na prikaz zapisa o poništenju sa opisom i nazivom davaoca uz
  /// pseudonim (nabavke čl. 33 st. 1): trenutak i SNIMAK prikazanog teksta.
  pristanakPrikazAt    DateTime?
  pristanakPrikazTekst String?
  /// Povlačenje pristanka na prikaz (nabavke čl. 33 st. 2): opis dobra, odnosno usluge i
  /// naziv davaoca brišu se iz opisa zapisa o poništenju (i ispravke), a zapis ostaje.
  /// `pristanakPrikazAt`/`Tekst` ostaju kao dokaz pristanka za prikaz pre povlačenja.
  pristanakPovucenAt   DateTime?
  createdAt            DateTime     @default(now())

  @@index([ugovorId, status])
  @@index([imalacId, status])
}

/// 🔴 NAPUŠTENO (set 5.0): javno dostupan izvor cene (ranije donacije čl. 13e–13f). Donacije
/// čl. 29 st. 2: Fondacija proverava samo da je fotografija cenovnika priložena, a cenu ne
/// procenjuje, ne upoređuje i ne određuje — pravila „najniže cene iz izvora" više nema.
/// Tabela ostaje zbog zatečenih redova; kod je ne čita i u nju ne upisuje.
model IzvorCeneDobra {
  id          String      @id @default(uuid())
  ugovorId    String
  ugovor      UgovorDobra @relation(fields: [ugovorId], references: [id], onDelete: Cascade)
  redniBroj   Int
  url         String
  datumIzvora DateTime
  cena        Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())

  @@unique([ugovorId, redniBroj])
}

/// Zaposleni davaoca (donacije čl. 32 st. 3, nabavke čl. 34 st. 1): korisnik koga je
/// podnosilac prijave odredio da u ime davaoca potvrđuje vaučere SVIH njegovih ugovora,
/// preko sopstvenog naloga. Nijedno drugo ovlašćenje ne stiče; opoziv u svakom trenutku.
/// 🔴 Najviše jedan aktivan red po paru drži delimičan jedinstveni indeks u migraciji
/// (`WHERE "opozvanAt" IS NULL`) — Prisma ga ne izražava u šemi.
model DavalacZaposleni {
  id              String            @id @default(uuid())
  /// Upis pokrovitelja za koji zaposleni potvrđuje vaučere (donacije čl. 16, čl.
  /// 32 st. 3). Zatečeni redovi su povezani migracijom.
  upisId          String?
  upis            UpisPokrovitelja? @relation(fields: [upisId], references: [id])
  /// Korisnik koji je zaposlenog odredio (vodi upis).
  davalacUserId   String
  davalac         User              @relation("DavalacZaposleniDavalac", fields: [davalacUserId], references: [id])
  zaposleniUserId String
  zaposleni       User              @relation("DavalacZaposleniZaposleni", fields: [zaposleniUserId], references: [id])
  dodatAt         DateTime          @default(now())
  opozvanAt       DateTime?
  /// `DAVALAC` (opoziv) ili `GASENJE_NALOGA` (ugašen nalog jedne strane).
  opozvanRazlog   String?

  @@index([davalacUserId, opozvanAt])
  @@index([upisId, opozvanAt])
  @@index([zaposleniUserId, opozvanAt])
}

/// Lista zabrane (donacije čl. 35 st. 5): davalac čiji je ugovor raskinut ne
/// zaključuje nov ugovor o pokroviteljstvu dobrima i uslugama DOK GA Fondacija ne
/// skine sa liste. Davalac se prepoznaje po matičnom broju (pravno lice,
/// preduzetnik), odnosno po broju gazdinstva. Skinut red ostaje kao istorija.
model ZabranaDavaoca {
  id             String            @id @default(uuid())
  /// Lista zabrane se vezuje za upis (donacije čl. 18 st. 3). MB/BPG ostaju kao
  /// zatečeni ključ.
  upisId         String?
  upis           UpisPokrovitelja? @relation(fields: [upisId], references: [id])
  vrstaDavaoca   VrstaDavaoca
  maticniBroj    String?
  bpg            String?
  naziv          String
  /// Ugovor čiji je raskid upisao zabranu.
  ugovorId       String?
  ugovor         UgovorDobra?      @relation(fields: [ugovorId], references: [id])
  razlog         String
  upisaoId       String?
  upisanoAt      DateTime          @default(now())
  skinutoAt      DateTime?
  skinuoId       String?
  skidanjeRazlog String?

  @@index([maticniBroj, skinutoAt])
  @@index([bpg, skinutoAt])
  @@index([upisId, skinutoAt])
}

/// Upis pokrovitelja u evidenciju (Pravilnik o pokroviteljstvu i donacijama čl. 16).
/// Pravno lice, preduzetnik ili registrovano poljoprivredno gazdinstvo upisuje se
/// JEDNOM; upis vodi korisnik koji ga je izvršio (`vlasnikUserId`) i iz odobrenog
/// upisa podnosi prijave novčanog pokroviteljstva (čl. 19) i pokroviteljstva dobrima
/// i uslugama (čl. 28).
///
/// 🔴 Najviše jedan živ upis po matičnom broju, odnosno BPG-u: drži delimičan
/// jedinstveni indeks u migraciji (`WHERE "obrisanAt" IS NULL AND status <>
/// 'ODBIJEN'`) — Prisma ga ne izražava u šemi.
/// 🔴 Javno se prikazuju SAMO naziv, logotip, mesto i adresa za mapu (čl. 26 st. 2).
/// MB, PIB, BPG, sedište, ime i kontakt čita samo administratorski tim i vlasnik upisa.
/// 🔴 Adresa na mapi nije opoziv pristanak: izjava je obavezna pri upisu, a izlaz je
/// samo brisanje upisa (čl. 18 st. 4), kad nema neiskorišćenih vaučera.
model UpisPokrovitelja {
  id                        String                  @id @default(uuid())
  vrsta                     VrstaDavaoca
  status                    StatusUpisaPokrovitelja @default(NA_PROVERI)
  vlasnikUserId             String
  vlasnik                   User                    @relation("VlasnikUpisa", fields: [vlasnikUserId], references: [id])
  /// Naziv pravnog lica ili preduzetnika, odnosno naziv gazdinstva.
  naziv                     String
  /// Samo FIRMA. Pravni oblik određuje odnos i izjave (čl. 16 st. 2–3, čl. 17); zatečeni upisi `null`.
  pravniOblik               PravniOblik?
  /// Samo FIRMA.
  adresaSedista             String?
  maticniBroj               String?
  pib                       String?
  /// Samo GAZDINSTVO — broj poljoprivrednog gazdinstva.
  bpg                       String?
  /// Gazdinstvo iz modula gazdinstava, kad je upis popunjen iz njega.
  gazdinstvoId              String?
  /// Ime i prezime korisnika koji upis vrši (zastupnik, preduzetnik, vlasnik,
  /// stvarni vlasnik, nosilac gazdinstva). U evidenciju identiteta ide tek pri
  /// potvrdi prijema donacije (čl. 19 st. 3). Zatečeni redovi mogu biti `null`.
  imePrezime                String?
  /// Funkcija zakonskog zastupnika (npr. direktor) — samo uz odnos ZASTUPNIK.
  zastupnikFunkcija         String?
  odnosPremaDavaocu         OdnosPremaDavaocu?
  kontaktEmail              String?
  kontaktTelefon            String?
  /// Logotip (čl. 26 st. 2) — javni URL na R2. 🔴 Bez veze ka internet stranici.
  logoUrl                   String?
  /// Mesto (naselje iz šifarnika), adresa i tačka za prikaz na mapi.
  mapaMesto                 String?
  mapaAdresa                String?
  mapaLat                   Float?
  mapaLng                   Float?
  /// Izjava da je pokrovitelj saglasan da se adresa prikazuje (čl. 16 st. 2 t. 3).
  izjavaAdresaAt            DateTime?
  /// Izjava o ovlašćenju (čl. 17 st. 1) — kad korisnik nije zastupnik ni preduzetnik.
  izjavaOvlascenjaAt        DateTime?
  /// Potvrda o načinu evidentiranja doprinosa (čl. 17 st. 2): trenutak i SNIMAK teksta.
  potvrdaEvidentiranjaAt    DateTime?
  potvrdaEvidentiranjaTekst String?
  /// Fondacija je naziv, MB i zastupnika uporedila sa registrom (čl. 18 st. 1) —
  /// beleži se samo da je poređenje izvršeno.
  aprProveraAt              DateTime?
  aprProverioId             String?
  odlukaAt                  DateTime?
  odlukaAdminId             String?
  odbijenoRazlog            String?
  /// Izmena naziva, MB odnosno logotipa na ponovnoj proveri (čl. 18 st. 2). Do
  /// odluke važe ranije odobrene vrednosti.
  izmenaNaziv               String?
  izmenaMaticniBroj         String?
  izmenaLogoUrl             String?
  izmenaPodnetaAt           DateTime?
  izmenaOdbijenaRazlog      String?
  /// Brisanje upisa (čl. 18 st. 4): prestaju prikaz na mapi i ponuda vaučera.
  obrisanAt                 DateTime?
  /// Na zahtev korisnika koji je vodio upis, pokrovitelj se uklanja i sa rang-liste.
  uklonjenSaRangListeAt     DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  prijave      PokroviteljPrijava[]
  ugovori      UgovorDobra[]
  zaposleni    DavalacZaposleni[]
  zabrane      ZabranaDavaoca[]
  pokrovitelji Pokrovitelj[]

  @@index([vlasnikUserId])
  @@index([status])
  @@index([maticniBroj])
  @@index([bpg])
  @@index([pib])
}

/// 🔴 Napušteno (set 4.7.8, 20.10.2026): prijava na raspodelu u krugovima više ne
/// postoji — vaučer se uzima slobodno (nabavke čl. 32 st. 2). Tabela ostaje zbog
/// zatečenih redova i GDPR izvoza; kod u nju ne piše.
/// Prijava člana na raspodelu vaučera (nabavke čl. 30, 32).
model PrijavaRaspodele {
  id                String      @id @default(uuid())
  ugovorId          String
  ugovor            UgovorDobra @relation(fields: [ugovorId], references: [id])
  krug              Int
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  /// Izjava „nisam povezano lice sa davaocem" (donacije čl. 36) — trenutak davanja.
  izjavaNepovezanAt DateTime
  /// DODELJEN | PRESKOCEN (nema dovoljno POEN-a, već ima dva vaučera, nema mesta)
  ishod             String?
  createdAt         DateTime    @default(now())

  @@unique([ugovorId, krug, userId])
  @@index([userId])
}

model PokroviteljDoprinos {
  id            String        @id @default(uuid())
  pokroviteljId String
  pokrovitelj   Pokrovitelj   @relation(fields: [pokroviteljId], references: [id])
  rsdIznos      Decimal       @db.Decimal(12, 2)
  tip           VrstaDonacije
  evidentiraoId String
  evidentirao   User          @relation("EvidentiraoDoprinos", fields: [evidentiraoId], references: [id])
  napomena      String?
  createdAt     DateTime      @default(now())

  @@index([pokroviteljId, createdAt(sort: Desc)])
}

model PokroviteljBonusEmisija {
  id            String      @id @default(uuid())
  pokroviteljId String
  pokrovitelj   Pokrovitelj @relation(fields: [pokroviteljId], references: [id])
  vlasnikId     String
  vlasnik       User        @relation("PrimalacBonusa", fields: [vlasnikId], references: [id])
  nivo          Int
  bonusPoen     Int
  transactionId String?
  createdAt     DateTime    @default(now())

  @@index([pokroviteljId])
  @@index([vlasnikId])
}

model Notifikacija {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tip       String
  // `naslov`/`tekst` su UVEK popunjeni srpskim tekstom — i kao rezerva i zbog
  // starih redova koji nemaju ključ. Kad je `kljuc` postavljen, prikaz i mejl
  // sklapaju rečenicu iz prevoda na jeziku primaoca (vidi src/lib/prevod-servera.ts).
  naslov    String
  tekst     String
  /**
   * Ključ u messages/*.json (npr. "notifikacije.transfer_primljen").
   */
  kljuc     String?
  /**
   * Vrednosti za popunjavanje ({pseudonim}, {iznos}...).
   */
  parametri Json?
  procitana Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, procitana])
  @@index([userId, createdAt(sort: Desc)])
}

// Web Push pretplata uređaja (browser Push API). Jedan korisnik može imati više
// pretplata (više uređaja/browsera). `endpoint` je jedinstven po pretplati;
// `p256dh`/`auth` su ključevi za enkripciju payload-a (VAPID). Briše se kaskadno
// pri brisanju naloga, a i kad push servis vrati 404/410 (pretplata istekla).
model PushPretplata {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Konverzacija {
  id            String   @id @default(uuid())
  user1Id       String
  user2Id       String
  user1         User     @relation("KonvUser1", fields: [user1Id], references: [id])
  user2         User     @relation("KonvUser2", fields: [user2Id], references: [id])
  poruke        Poruka[]
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  /// Oglas sa kog je kliknuto „Kontaktiraj", a poruka još nije napisana.
  /// Čovek često otvori razgovor pa napiše tek kasnije, iz liste razgovora —
  /// zato povod čeka OVDE, a ne u adresi stranice. Troši ga prva poruka onoga
  /// ko nije vlasnik oglasa i prelazi na `Poruka.oglasId`.
  povodOglasId String?
  povodOglas   MarketplaceListing? @relation("KonvPovod", fields: [povodOglasId], references: [id], onDelete: SetNull)
  /// Ko je razgovor otvorio — broji dnevni limit novog člana (Uslovi čl. 14 st. 2).
  /// Zatečeni razgovori ostaju `null`.
  pokrenuoId   String?

  @@unique([user1Id, user2Id])
  @@index([user1Id, lastMessageAt(sort: Desc)])
  @@index([user2Id, lastMessageAt(sort: Desc)])
}

model Poruka {
  id             String       @id @default(uuid())
  konverzacijaId String
  konverzacija   Konverzacija @relation(fields: [konverzacijaId], references: [id])
  posiljacId     String
  posiljac       User         @relation("PorukePostavljene", fields: [posiljacId], references: [id])
  tekst          String
  procitana      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  /// Oglas povodom kog je poruka poslata. Konverzacija je jedna po PARU ljudi,
  /// pa povod ne može da stoji na njoj — isti dvoje se tokom vremena javljaju
  /// povodom više oglasa. SetNull: brisanje oglasa ne briše tuđu poruku.
  ///
  /// Do seta 4.8.0 odvojeno od `OglasUpit` (upiti za korak 3 putanje); ovo je PRIKAZ u
  /// razgovoru (sličica i link), a ne merilo.
  oglasId String?
  oglas   MarketplaceListing? @relation("PorukaOglas", fields: [oglasId], references: [id], onDelete: SetNull)

  @@index([konverzacijaId, createdAt])
  @@index([oglasId])
}

// ─── Politika privatnosti — verzionisanje i pristanci ────────────────────────

model PolitikaVerzija {
  id          String                @id @default(uuid())
  verzija     String                @unique // npr. "1.0", "1.1"
  naslov      String
  efektivnaOd DateTime
  kreirao     String // adminId
  createdAt   DateTime              @default(now())
  pristanci   PolitikaPrihvatanje[]
}

model PolitikaPrihvatanje {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  verzijaId String
  verzija   PolitikaVerzija @relation(fields: [verzijaId], references: [id])
  prihvacen Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@unique([userId, verzijaId])
  @@index([userId])
}

// ─── Dokaz pristanka (ZZPL cl. 15 st. 1, set 4.6.3 — R-06) ──────────────────

/// Na sta je pristanak dat. Jedna vrsta = jedno pitanje na koje se pristaje:
/// ZZPL cl. 15 st. 2 trazi da pristanak koji pokriva vise pitanja bude razdvojen,
/// pa se dve kvacice pri registraciji upisuju kao DVA reda, nikad kao jedan.
enum VrstaPristanka {
  USLOVI_KORISCENJA
  POLITIKA_PRIVATNOSTI
  KOLACICI_ANALITIKA
}

/// Dokaz da je lice dalo pristanak (ZZPL cl. 15 st. 1 — teret dokazivanja je na
/// rukovaocu, ne na licu).
///
/// Do seta 4.6.3 nije postojao nijedan zapis: kvacice pri registraciji zivele su
/// iskljucivo u pretrazivacu, a `POST /api/registracija` nije primao nijedno polje
/// o prihvatanju. Time nije nedostajao samo dokaz pristanka nego i dokaz da je
/// ugovor zakljucen — a „izvrsenje ugovornog odnosa" je pravni osnov za vecinu
/// obrada u Politici cl. 4.
///
/// 🔴 NEMA IP ADRESE NI PODATAKA O UREDJAJU. Prikupljanje otiska uredjaja radi
/// dokazivanja pristanka na obradu bilo bi prosirenje obrade suprotno cl. 3
/// Politike, gde minimizacija stoji kao „strukturni princip koji se ne moze ukinuti
/// nijednom upravljackom odlukom". Dokaz nosi verzija akta, snimljen tekst i
/// trenutak — ne otisak.
///
/// 🟢 Zasto je dovoljno snimiti VERZIJU, a ne ceo akt: pravilo bumpovanja
/// (CLAUDE.md) obezbedjuje da objavljen fajl nikad ne promeni sadrzaj — sifra u
/// imenu fajla JESTE objava. `uslovi_koriscenja_4_6_3.md` zato trajno govori ono
/// sto je govorio na dan davanja pristanka. `tekst` nosi ono sto je covek stvarno
/// procitao na ekranu (tekst kvacice odn. bannera), na jeziku na kom mu je
/// prikazan.
model ZapisPristanka {
  id      String         @id @default(uuid())
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vrsta   VrstaPristanka
  /// Verzija akta na koji se pristanak odnosi ("4.6.3"), odnosno verzija teksta
  /// bannera za kolacice. Bez nje „pristao je na Politiku" ne znaci nista posle
  /// prve izmene.
  verzija String
  /// Tekst koji je covek video, SNIMLJEN. Ne generisati ga ponovo pri citanju —
  /// isti razlog kao `DonationRecord.ugovorTekst`, `OglasPrijava.izjavaTekst` i
  /// `Roditeljstvo.izjavaTekst`.
  tekst   String
  /// Jezik na kom je tekst prikazan. 🔴 Obrnuto od ugovora o donaciji, koji je na
  /// srpskom na svim jezicima: ugovor je pravni dokument po srpskom pravu, a
  /// pristanak mora biti na jeziku razumljivom onome ko ga daje (ZZPL cl. 15 st. 2
  /// — „jasan i jednostavan jezik").
  jezik   String
  /// Gde je dat: "registracija", "oauth", "kolacici".
  izvor   String

  datAt     DateTime  @default(now())
  /// Popunjen kad je pristanak opozvan (ZZPL cl. 15 st. 3 — opoziv mora biti
  /// jednako lak kao davanje). Red se NE brise: opoziv ne cini raniju obradu
  /// nezakonitom, pa dokaz da je pristanak postojao mora da ostane.
  povucenAt DateTime?

  /// Jedan red po (korisnik, vrsta, verzija). Ponovljen pristanak na istu verziju
  /// nije nov podatak nego isti — pa se upis ponasa idempotentno (dupli submit
  /// registracije, ponovno prihvatanje kolacica posle opoziva). Ko pristanak da
  /// posle opoziva, ozivljava isti red (`povucenAt` se brise, `datAt` se pomera).
  @@unique([userId, vrsta, verzija])
  @@index([userId])
  @@index([userId, vrsta])
}

// ─── Verzionisanje Pravilnika (paralelno sa Politikom, v3.7.0) ───────────────

model PravilnikVerzija {
  id          String                 @id @default(uuid())
  verzija     String                 @unique // npr. "3.7.0"
  naslov      String
  efektivnaOd DateTime
  kreirao     String // adminId
  createdAt   DateTime               @default(now())
  pristanci   PravilnikPrihvatanje[]
}

model PravilnikPrihvatanje {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  verzijaId String
  verzija   PravilnikVerzija @relation(fields: [verzijaId], references: [id])
  prihvacen Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@unique([userId, verzijaId])
  @@index([userId])
}

// ─── Osnivacki doprinos (Pravilnik o osnivackom doprinosu; Pravilnik cl. 35) ──

model OsnivackiKanal {
  id                   String    @id @default("singleton")
  ukupnoEvidentirano   Int       @default(0) // ukupno POEN-a stvarno evidentirano kroz kanal (max 2.400.000; manje kad su koraci umanjeni, cl. 8 st. 3)
  brojKoraka           Int       @default(0) // broj izvrsenih koraka (max 100)
  zatvoren             Boolean   @default(false) // postaje true kad brojKoraka = 100 (cl. 10)
  zatvorenAt           DateTime?
  poslednjiPrag        Int       @default(0) // posljednji aktiviran prag (100.000, 200.000, ...)
  osnivaciZakljucani   Boolean   @default(false) // lista zakljucana = odluka o raspodeli objavljena (cl. 8 st. 4); trajno, ne otkljucava se (cl. 2 st. 3); emisija ide samo kad je zakljucano
  osnivaciZakljucaniAt DateTime?
  updatedAt            DateTime  @updatedAt
}

model Osnivac {
  id           String                  @id @default(uuid())
  userId       String                  @unique
  user         User                    @relation("Osnivac", fields: [userId], references: [id])
  udeoBrojilac Int // npr. 50 (znaci 50/zbir)
  udeoImenilac Int // npr. 100 (znaci 50/100 = 50%)
  redniBroj    Int                     @unique // redosled u javnom registru
  napomena     String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  emisije      OsnivackiKorakEmisija[]
}

model OsnivackiKorakLog {
  id                 String                  @id @default(uuid())
  brojKoraka         Int                     @unique // 1, 2, ..., 100
  prag               Int // POEN prag koji je aktivirao korak (100k, 200k, ...)
  ukupanPoenUSistemu Int // total POEN-a u sistemu u trenutku okidanja
  iznosKoraka        Int                     @default(24000) // stvarno evidentirano u koraku: 24.000, umanjeno za udeo osnivaca kome je prestao status (cl. 8 st. 3)
  createdAt          DateTime                @default(now())
  emisije            OsnivackiKorakEmisija[]
}

model OsnivackiKorakEmisija {
  id            String            @id @default(uuid())
  korakLogId    String
  korakLog      OsnivackiKorakLog @relation(fields: [korakLogId], references: [id])
  osnivacId     String
  osnivac       Osnivac           @relation(fields: [osnivacId], references: [id])
  iznosPoen     Int // emitovano ovom osnivacu u ovom koraku
  transactionId String? // veza na Transaction
  createdAt     DateTime          @default(now())

  @@unique([korakLogId, osnivacId])
}

// ─── Fondacija — transparentnost sredstava i Zastitni veto (cl. 71) ──────────

enum FondacijaTrosakKategorija {
  PLATA
  INFRASTRUKTURA // hosting, domeni, serveri
  PRAVNI_TROSAK // advokati, sudski vestaci, registracije
  SOFTWARE // pretplate na alate, licence
  ADMINISTRATIVNO // bankarski troskovi, pisarnica, materijal
  OPERATIVNO // ostali operativni troskovi
  DRUGO
}

model FondacijaTrosak {
  id          String                    @id @default(uuid())
  datum       DateTime                  @db.Date
  iznosRSD    Decimal                   @db.Decimal(12, 2)
  kategorija  FondacijaTrosakKategorija
  opis        String
  dokumentUrl String? // link na racun/ugovor (opciono)
  kreiraoId   String
  kreirao     User                      @relation("KreiraoTrosak", fields: [kreiraoId], references: [id])
  createdAt   DateTime                  @default(now())

  @@index([datum])
  @@index([kategorija, datum])
}

model SistemskiVeto {
  id              String    @id @default("singleton")
  aktivan         Boolean   @default(false) // true kad Protokol < -1M I trajnoUgasen = false
  trajnoUgasen    Boolean   @default(false) // jednosmerni flag (cl. 71)
  datumAktivacije DateTime?
  datumGasenja    DateTime? // kada je trajnoUgasen postao true
  updatedAt       DateTime  @updatedAt
}

// ─── Prigovor na automatizovanu odluku ───────────────────────────────────────

enum PrigovorStatus {
  PENDING
  U_OBRADI
  RESENO
  ODBIJENO
}

model PrigovorNaOdluku {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  opis        String
  tipOdluke   String // vidi VRSTE_PRIGOVORA u src/lib/prigovor-pravila.ts
  /// Predmet na koji se prigovor odnosi (Uslovi čl. 40 st. 3): id prepisa za
  /// RAZMENA, id prijave na nabavku za NABAVKA. Bez njega se o tim vrstama ne
  /// može odlučiti — odluka se vodi o TAČNO JEDNOM zapisu.
  predmetId   String?
  status      PrigovorStatus @default(PENDING)
  odgovor     String?
  odgovorioId String?
  odgovorioAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  prijavaRazmene PrijavaRazmene?

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
}

// ─── Blog (Vesti Fondacije) ──────────────────────────────────────────────────

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  content     String
  authorId    String
  author      User     @relation("BlogAutor", fields: [authorId], references: [id])
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt(sort: Desc)])
}

// ─── Chat soba (globalna) ────────────────────────────────────────────────────

/// Soba Pričaonice. 🔴 Soba se NE BIRA nego se izvodi iz toga ko piše: maloletni
/// korisnik uvek dobija dečju, punoletni uvek sobu odraslih. Nema parametra kojim
/// bi se prešlo iz jedne u drugu — to je jedini način da se sigurno zna da odrasli
/// nisu u dečjoj sobi (Pravilnik o učešću dece, čl. 27 st. 1).
enum ChatSoba {
  ODRASLI
  DECA
}

model ChatMessage {
  id             String    @id @default(uuid())
  soba           ChatSoba  @default(ODRASLI)
  userId         String
  user           User      @relation("ChatPoruke", fields: [userId], references: [id])
  content        String
  createdAt      DateTime  @default(now())
  // Autor je sam izmenio tekst (bez roka, odluka vlasnika 28.10.2026). Čuva se
  // samo trenutak poslednje izmene; ranije verzije teksta se ne čuvaju.
  izmenjenoAt    DateTime?
  // Uklanjanje od strane Fondacije (Uslovi čl. 29 st. 2 — obuhvata „svu drugu
  // komunikaciju putem Platforme"). Meko brisanje: poruka nestaje iz sobe, ali
  // ostaje trag ko je i zašto uklonio dok je noćni cron ne pobriše sa ostalima.
  uklonjenoAt    DateTime?
  uklonjenRazlog String?
  uklonioId      String?

  @@index([soba, createdAt(sort: Desc)])
  @@index([userId])
}

// ─── Dokaz stvarnosti — graf verifikacija (Pravilnik v3.5.0) ─────────────────

model VerifikacionaVeza {
  id                 String           @id @default(uuid())
  verifikatorId      String
  verifikator        User             @relation("Verifikator", fields: [verifikatorId], references: [id])
  redniBroj          Int
  verifikovaniId     String
  verifikovani       User             @relation("Verifikovani", fields: [verifikovaniId], references: [id])
  vremenskiZig       DateTime         @default(now())
  // Slobodna oznaka (nadimak) koju verifikator dodeljuje verifikovanome — da bi lakše
  // pratio koga je verifikovao. NIJE javna: vidljiva samo verifikatoru i UO Fondacije
  // (admin). Ne objavljuje se drugim korisnicima i ne kači se na javnu evidenciju
  // doprinosa (Pravilnik o dokazu stvarnosti, dopuna 3.9.1; čl. 31).
  oznakaVerifikatora String?
  // Poslednji nadzornik i trenutak poslednjeg evidentiranog ishoda. Pun trag ide u
  // NadzorZapis — po ishodu "za proveru" zapis gleda više nadzornika, a jedno polje
  // ne može da nosi dvoje ljudi (dokaz stvarnosti 4.2.0, čl. 11).
  nadzornikId        String?
  nadzornik          User?            @relation("Nadzornik", fields: [nadzornikId], references: [id])
  podlezeNadzoru     Boolean
  nadzoranAt         DateTime?
  // Merodavan ishod = poslednji evidentirani. UREDNO je jedini koji dopunjava slot
  // kapaciteta verifikatora (čl. 11 st. 2 al. 1).
  nadzorIshod        NadzorIshod?
  nadzorZapisi       NadzorZapis[]
  nadzorniPredmet    NadzorniPredmet?

  // ── POEN po potvrdi čeka trag stvarnog učešća (dokaz stvarnosti čl. 19) ──────────
  // Do seta 4.6.4 je Protokol upisivao 1.000 + 1.000 ODMAH po potvrdi, automatski i
  // bez ijednog traga da je potvrđeni išta uradio. Sada se POEN beleži, a upisuje kad
  // potvrđeni ostvari doprinos koji je NEKO POTVRDIO — Fondacija (odobren prvi oglas,
  // javna donacija, pokroviteljstvo) ili nosilac ZRNA odn. UO (operativni doprinos).
  //
  // 🔴 Sam čin potvrde se ne menja: indeks se puni odmah, nalog je redovan član istog
  // časa. Čeka SAMO zapis POEN-a. Pravila su u `src/lib/potvrda-uslov.ts`.
  //
  // 🔴 Nadzornikovih 500 ovo NE dodiruje — po čl. 7 st. 2 već imaju svoj trenutak
  // (evidentiranje ishoda nadzora) i svoj razlog (plaća se rad, ne pečat).
  poenStatus              PotvrdaPoenStatus @default(ZABELEZEN)
  poenEvidentiranAt       DateTime?
  /// Koji je uslov otključao upis — da se iz zapisa vidi šta se dogodilo.
  poenUslov               PotvrdaPoenUslov?
  /// Transakcije kojima je POEN upisan (postoje tek u EVIDENTIRAN).
  verifikatorTxId         String?
  verifikovaniTxId        String?
  // Nadzornikovih 500 (čl. 7 st. 2) čekaju ISTI uslov, ali imaju SVOJE stanje —
  // odluka vlasnika 16.09.2026. Zaseban skup polja je nužan zato što ta emisija
  // ima svoj trenutak nastanka (upis ishoda nadzora), različit od trenutka potvrde:
  // nadzornik ume da upiše ishod pre nego što uslov bude ispunjen, i posle toga.
  // Sa jednim poljem se ne bi moglo razlikovati „nije upisano jer nema ishoda" od
  // „nije upisano jer uslov nije ispunjen", pa bi kaskada vraćala POEN koji ne
  // postoji.
  nadzorPoenStatus        PotvrdaPoenStatus @default(ZABELEZEN)
  nadzorPoenEvidentiranAt DateTime?
  nadzorTxId              String?
  /// Verifikator je obavešten da potvrđeni 30 dana posle potvrde nema nijednu razmenu
  /// (noćni nadzor integriteta, set 4.8.0). Obaveštava se jednom.
  bezRazmeneJavljenoAt    DateTime?
  /// Uvođenje u Kolo posle razgovora telefonom sa korisnikom sa spiska za poziv
  /// (dokaz stvarnosti čl. 4 st. 1, čl. 22 st. 1 t. 5, čl. 25; set 4.8.2). Na takvoj vezi
  /// automatska potvrda lanca staje; uvek podleže nadzoru (osim kod osnivača).
  /// Ime kolone ostaje iz seta 4.8.1 (CLAUDE.md pravilo 12), značenje je novo.
  poPozivu                Boolean           @default(false)
  /// Vrsta verifikacije (dokaz stvarnosti čl. 4, čl. 18 st. 1 t. 5): potvrda (član
  /// Kola koji osobu lično zna) ili uvođenje u Kolo.
  vrsta                   VrstaVerifikacije @default(POTVRDA)
  /// Verifikator je u trenutku verifikacije bio član bez potvrde (čl. 4 st. 2 —
  /// lanac teče samo kroz takva uvođenja; čl. 25 — red i signal nadzora).
  verifikatorBezPotvrde   Boolean           @default(false)
  potvrdeClana            PotvrdaClana[]

  @@unique([verifikatorId, redniBroj])
  // K6: isti verifikator ne sme dvaput da verifikuje istog korisnika (anti-inflacija
  // indeksa + zatvara race na anti-cirkularnoj proveri kod recipročnih/duplih veza).
  @@unique([verifikatorId, verifikovaniId])
  @@index([verifikatorId])
  @@index([verifikovaniId])
  @@index([nadzornikId])
  // Noćni prolaz `/api/cron/potvrde-uslov` i pregled u admin tabu traže zabeležene
  // potvrde po potvrđenom korisniku.
  @@index([verifikovaniId, poenStatus])
}

/// Vrsta verifikacije (dokaz stvarnosti čl. 4, set 4.8.2).
enum VrstaVerifikacije {
  POTVRDA
  UVODJENJE
}

/// Ko je potvrdio člana bez potvrde (dokaz stvarnosti čl. 5).
enum IzvorPotvrdeClana {
  CLAN_KOLA
  FONDACIJA
  /// Automatska potvrda lanca (stari čl. 5a st. 5) — ukinuta setom 4.8.3; ostaje
  /// samo kao stari zapis. Ne ulazi u dnevni tempo, uvek nadzor.
  LANAC
}

/// Kako je član Kola potvrdio člana bez potvrde (dokaz stvarnosti čl. 5, 16, 17;
/// set 4.8.3). Samo uz izvor CLAN_KOLA; zatečeni redovi ostaju null (pravilo 11).
enum NacinPotvrdeClana {
  /// Lično poznanstvo (čl. 5 st. 1 t. 1).
  LICNO
  /// Čuvar Kola posle razgovora telefonom (čl. 16) — uvek nadzor.
  TELEFONOM
  /// Označavanje sa spiska povezanih (čl. 17).
  SPISAK_POVEZANIH
}

/// Potvrda člana bez potvrde (dokaz stvarnosti čl. 5, set 4.8.2).
///
/// NIJE nova verifikacija: ne nastaje nova `VerifikacionaVeza`, ne nosi POEN i ne
/// menja indeks. Vezuje se za uvođenje kojim je član verifikovan i beleži ko je
/// potvrdio i kada. Poništava se posebno (čl. 33 st. 1) — `aktivnaKljuc` je tada
/// null, pa je najviše jedna živa potvrda po uvođenju.
///
/// 🔴 Poništenje potvrde koja je pokrenula lanac NE obara potvrde iz lanca
/// (`lanacOdId` je samo trag).
model PotvrdaClana {
  id               String             @id @default(uuid())
  verifikacijaId   String
  verifikacija     VerifikacionaVeza  @relation(fields: [verifikacijaId], references: [id], onDelete: Cascade)
  potvrdjeniId     String
  potvrdjeni       User               @relation("PotvrdaClanaPotvrdjeni", fields: [potvrdjeniId], references: [id], onDelete: Cascade)
  izvor            IzvorPotvrdeClana
  /// Član Kola koji je potvrdio; kod FONDACIJA administrator koji upisuje odluku;
  /// kod LANAC null.
  potvrdioId       String?
  potvrdio         User?              @relation("PotvrdaClanaPotvrdio", fields: [potvrdioId], references: [id], onDelete: SetNull)
  /// Potvrda koja je pokrenula automatsku potvrdu lanca (samo kod LANAC).
  lanacOdId        String?
  lanacOd          PotvrdaClana?      @relation("LanacPotvrda", fields: [lanacOdId], references: [id], onDelete: SetNull)
  lanacPotvrde     PotvrdaClana[]     @relation("LanacPotvrda")
  /// Korak u lancu (1..n od potvrđenog člana bez potvrde); samo kod LANAC.
  korak            Int?
  /// Obavezno kod FONDACIJA (odluka sa obrazloženjem).
  obrazlozenje     String?
  /// Samo kod CLAN_KOLA, od seta 4.8.3; zatečeni redovi su null.
  nacin            NacinPotvrdeClana?
  /// Potvrda onoga ko je potvrdiocu bio uvodilac (čl. 17 st. 3) — izuzetak od čl. 28,
  /// uvek nadzor.
  premaUvodiocu    Boolean            @default(false)
  createdAt        DateTime           @default(now())
  podlezeNadzoru   Boolean
  nadzornikId      String?
  nadzoranAt       DateTime?
  nadzorIshod      NadzorIshod?
  nadzorZapisi     NadzorZapis[]
  nadzorniPredmet  NadzorniPredmet?
  ponistenaAt      DateTime?
  ponistioId       String?
  razlogPonistenja String?
  /// = `verifikacijaId` dok potvrda važi; null posle poništenja.
  aktivnaKljuc     String?            @unique

  @@index([potvrdjeniId])
  @@index([potvrdioId, createdAt])
  @@index([podlezeNadzoru, nadzorIshod])
}

/// Spisak za poziv — „Želim da me neko nazove" (dokaz stvarnosti čl. 8–13; do seta 5.0 i Uslovi
/// čl. 16b; set 4.8.2). Ime modela i ruta ostaju iz seta 4.8.1 (pravilo 12).
///
/// Vide ga članovi Kola; ime i broj se otvaraju klikom, jednom po jednom članu, na
/// `BROJ_OTVOREN_MINUTA`. Red se BRIŠE pri verifikaciji korisnika, povlačenjem i
/// gašenjem naloga. `otvorioId` i `otvorenDo` nose samo TEKUĆE otvaranje; trajan
/// zapis o tome ko je otvorio podatke je `ZapisOtvaranjaPoziva`.
model ZahtevZaRazgovor {
  id             String      @id @default(uuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Osnov ulaska na spisak (čl. 8).
  osnov          OsnovSpiska @default(ZAHTEV)
  /// Mesto, opis i dostupnost su obavezni samo za osnov ZAHTEV.
  mesto          String?
  opis           String?
  dostupnost     String?
  telefon        String
  /// Snimljen tekst pristanka (ne generiše se ponovo pri čitanju).
  pristanakTekst String
  createdAt      DateTime    @default(now())
  otvorioId      String?
  otvorenDo      DateTime?

  @@index([otvorioId])
}

/// Osnov ulaska na spisak za poziv (dokaz stvarnosti čl. 8).
enum OsnovSpiska {
  ZAHTEV
  DONACIJA
  POKROVITELJSTVO
  /// Ime ostaje (pravilo 12); od seta 4.8.3 svako gazdinstvo, i van registra.
  GAZDINSTVO_RPG
  /// Član bez potvrde traži razgovor radi potvrde sa čuvarom Kola (čl. 8 st. 4, čl. 16; set 4.8.3).
  POTVRDA
}

/// Zapis o tome ko je otvorio ime i broj korisnika sa spiska za poziv (dokaz
/// stvarnosti čl. 10 st. 4; radnja obrade br. 24). Bez imena
/// i broja. Briše se gašenjem naloga POZVANOG; kroz Platformu se ne izvozi.
model ZapisOtvaranjaPoziva {
  id         String   @id @default(uuid())
  pozvaniId  String
  pozvani    User     @relation("OtvaranjePozvani", fields: [pozvaniId], references: [id], onDelete: Cascade)
  otvorioId  String
  otvorio    User     @relation("OtvaranjeOtvorio", fields: [otvorioId], references: [id], onDelete: Cascade)
  otvorenoAt DateTime @default(now())

  @@index([pozvaniId])
  @@index([otvorioId])
}

// ─── Nadzor verifikacija — ishod i predmet (dokaz stvarnosti 4.2.0) ──────────
// Do 4.2.0 nadzornik je mogao samo da POTVRDI verifikaciju ili da ne uradi ništa —
// polja za "proverio sam i nešto ne štima" nije bilo, pa je podsticaj gurao ka
// propuštanju. Sada svaki nadzor ostavlja zabeležen ishod (čl. 24).

enum NadzorIshod {
  UREDNO // nema primedbi → dopunjava se slot kapaciteta verifikatora
  ZA_PROVERU // nadzorniku nije jasno → zapis ide drugom nadzorniku, slot se NE dopunjava
  SPORNO // nadzornik smatra da verifikacija nije istinita → slot se NE dopunjava
}

enum NadzorSubjekt {
  VERIFIKATOR
  VERIFIKOVANI
  OBA
  DEO_MREZE
}

enum NadzorniPredmetStatus {
  OTVOREN
  UTVRDJENA_LAZNA
  NEMA_OSNOVA
}

// Jedan red po nadzorniku po verifikaciji. `@@unique` je ono što tehnički sprovodi
// zabranu iz čl. 23 st. 3 — isti nadzornik ne sme dvaput da gleda isti zapis.
// Set 4.8.2: predmet nadzora je TAČNO JEDNO od tri — verifikacija, potvrda člana
// bez potvrde ili potvrda postojanja deteta (CHECK u migraciji).
model NadzorZapis {
  id                  String                   @id @default(uuid())
  verifikacijaId      String?
  verifikacija        VerifikacionaVeza?       @relation(fields: [verifikacijaId], references: [id], onDelete: Cascade)
  potvrdaClanaId      String?
  potvrdaClana        PotvrdaClana?            @relation(fields: [potvrdaClanaId], references: [id], onDelete: Cascade)
  potvrdaPostojanjaId String?
  potvrdaPostojanja   PotvrdaPostojanjaDeteta? @relation(fields: [potvrdaPostojanjaId], references: [id], onDelete: Cascade)
  nadzornikId         String
  nadzornik           User                     @relation("NadzorZapisi", fields: [nadzornikId], references: [id])
  ishod               NadzorIshod
  // Obavezni uz ZA_PROVERU i SPORNO, prazni uz UREDNO (čl. 24 st. 3).
  subjekt             NadzorSubjekt?
  razlog              String? // šifra sa liste iz čl. 24 st. 4
  opis                String? // samo uz razlog "ostalo"
  // 500 POEN ide PRVOM nadzorniku koji evidentira ishod, bez obzira koji je (čl. 7 st. 2).
  // Drugi ne dobija ništa — inače bi se isplatilo lančano dodavati nadzornike.
  poenEvidentiran     Boolean                  @default(false)
  createdAt           DateTime                 @default(now())

  @@unique([verifikacijaId, nadzornikId])
  @@unique([potvrdaClanaId, nadzornikId])
  @@unique([potvrdaPostojanjaId, nadzornikId])
  @@index([verifikacijaId])
  @@index([nadzornikId])
}

// Nadzorni predmet (čl. 27). Alat, ne organ — odlučuje Fondacija po čl. 32.
// Jedan po verifikaciji: drugi nadzornik koji doda ishod ažurira postojeći predmet.
// Vidi ga SAMO superadmin. Cascade je namerna: poništenjem verifikacije nestaje i
// predmet, a trag radnje ostaje u audit logu.
model NadzorniPredmet {
  id                  String                   @id @default(uuid())
  verifikacijaId      String?                  @unique
  verifikacija        VerifikacionaVeza?       @relation(fields: [verifikacijaId], references: [id], onDelete: Cascade)
  potvrdaClanaId      String?                  @unique
  potvrdaClana        PotvrdaClana?            @relation(fields: [potvrdaClanaId], references: [id], onDelete: Cascade)
  potvrdaPostojanjaId String?                  @unique
  potvrdaPostojanja   PotvrdaPostojanjaDeteta? @relation(fields: [potvrdaPostojanjaId], references: [id], onDelete: Cascade)
  status              NadzorniPredmetStatus    @default(OTVOREN)
  subjekt             NadzorSubjekt
  razlog              String
  opis                String?
  otvorenAt           DateTime                 @default(now())
  resenById           String?
  resenBy             User?                    @relation("PredmetiReseni", fields: [resenById], references: [id])
  resenAt             DateTime?
  beleska             String?

  @@index([status, otvorenAt])
  @@index([resenById])
}

// ─── Zabranjena zona verifikacije (dokaz stvarnosti 3.9.2, čl. 12) ───────────
// Materijalizovana simetrična zabranjena zona: red (userId, forbiddenUserId)
// znači da userId NE SME da verifikuje forbiddenUserId (provera ide u OBA smera,
// čl. 12: "...niti korisnika u čijoj se zabranjenoj zoni sam nalazi").
// Ovo je KEŠ — izvor istine je tabela VerifikacionaVeza; celokupno stanje se
// deterministički izvodi iz grafa funkcijom recomputeZones (src/lib/protokol/zona.ts)
// i sinhronizuje u istoj transakciji sa svakim upisom, poništavanjem ili
// prestankom statusa. Skup je monoton pri upisu (unije), a pri poništavanju se
// NE oduzima inkrementalno (unija nije invertibilna) nego preračunava od nule.
/// Stanje upisa POEN-a po potvrdi (dokaz stvarnosti čl. 19).
/// ZABELEZEN = potvrda važi i indeks je upisan, ali POEN još nije zapis — ne ulazi ni
/// u jedno stanje, ni u opticaj, ni u javne agregate. Isti odnos kao `DoprinosStatus`.
enum PotvrdaPoenStatus {
  ZABELEZEN
  EVIDENTIRAN
  /// Potvrda je oborena pre nego što je POEN upisan — tada se samo gasi, BEZ
  /// protivzapisa i BEZ nadoknade po čl. 36: nema šta da se poništi.
  PONISTEN
}

/// Trag učešća koji je otključao upis. Vrednosti prate `UslovPotvrde` iz
/// `src/lib/potvrda-uslov.ts` — menjaju se zajedno.
enum PotvrdaPoenUslov {
  OGLAS
  DONACIJA
  POKROVITELJSTVO
  OPERATIVNI
}

model VerifikacijaToken {
  id         String    @id @default(uuid())
  token      String    @unique
  brojCifara String    @unique
  korisnikId String
  korisnik   User      @relation(fields: [korisnikId], references: [id])
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  used       Boolean   @default(false)
  usedAt     DateTime?

  @@index([korisnikId])
  @@index([expiresAt])
}

// ─── Tabla zahteva za jemstvo ─────────────────────────────────────────────────
// Neverifikovan korisnik se predstavlja mreži verifikovanih radi uspostavljanja
// kontakta neophodnog za verifikaciju (čl. 32 Pravilnika, čl. 16 Uslova korišćenja).
//
// REDIZAJN „kartica prepoznavanja" — objava se više NE PIŠE kao slobodan tekst,
// nego se SASTAVLJA iz polja. Razlog: slobodan tekst se u praksi popunjavao kao
// oglas („bavim se pčelarstvom") — formalno validno, a niko ne može da prepozna
// osobu. Struktuirana polja + poznato mesto omogućavaju da sistem sam dovede
// kandidata onome ko ga najverovatnije poznaje (vidi Prepoznavanje).
//
// Sva polja kartice su OPCIONA (nikoga ne zaustavljamo na vratima), ali kartica
// bez `ime` + `mesto` NE ULAZI u feed — bez mesta se ne može nikome dovesti.
//
// `telefon` je SKRIVEN — nikad se ne prikazuje na kartici. Vidi ga isključivo
// UO, i to samo kad je `telefonSaglasnost` = true (svrha: da Fondacija pozove
// čoveka koga niko od članova nije prepoznao). Briše se kad korisnik bude
// verifikovan, kad objava istekne i kad se ukloni. Svaki pristup se loguje.

enum JemstvoStatus {
  AKTIVAN
  POVUCEN
  ISTEKAO
  UKLONJEN
  ZAVRSEN
  NEPOTPUN // legacy objava (slobodan tekst) — stoji na zidu, ne ulazi u feed
}

enum PrepoznavanjeOdgovor {
  DA
  NE
  NISAM_SIGURAN
}

model ZahtevZaJemstvo {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // ── Kartica prepoznavanja (vidljiva verifikovanom članu) ──
  ime        String?
  prezime    String?
  godiste    Int? // godina rođenja — razlikuje imenjake, nagoveštava generaciju
  mesto      String? // iz šifarnika NASELJA_SRBIJE (validira se na serveru)
  nadimak    String? // nadimak ili kućno ime — najjači signal u malim mestima
  cimeSeBavi String? // „čime se baviš / po čemu te znaju", max 100 znakova

  // ── Skriveni kontakt (nikad na kartici, vidi ga samo UO) ──
  telefon           String?
  telefonSaglasnost Boolean @default(false)

  // ── Legacy (redizajn): stari slobodan tekst se NE parsira automatski —
  //    pogrešno izvučeno ime je gore od nikakvog. Čuva se kao arhiva, a
  //    zahtev dobija status NEPOTPUN uz poziv vlasniku da dopuni karticu.
  //    `tekstPredstavljanja`/`kontaktPodaci` ostaju jedan ciklus radi povratka.
  legacyTekst         String?
  tekstPredstavljanja String?
  kontaktPodaci       String?

  status         JemstvoStatus @default(AKTIVAN)
  uklonjenRazlog String?
  createdAt      DateTime      @default(now())
  expiresAt      DateTime

  prepoznavanja Prepoznavanje[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([status, mesto]) // feed: kandidati iz istog mesta
}

// Odgovor verifikovanog člana na pitanje „Poznaješ li ovu osobu?".
// SVA TRI odgovora se upisuju — bez upisa „NE"/„NISAM_SIGURAN" feed bi vrteo
// iste ljude u krug. Odgovor DA otvara SAMO kanal komunikacije; formalni čin
// jemstva je zaseban akt (VerifikacionaVeza) i ova tabela ga NE zamenjuje.
model Prepoznavanje {
  id         String               @id @default(uuid())
  zahtevId   String
  zahtev     ZahtevZaJemstvo      @relation(fields: [zahtevId], references: [id], onDelete: Cascade)
  korisnikId String
  korisnik   User                 @relation(fields: [korisnikId], references: [id])
  odgovor    PrepoznavanjeOdgovor
  createdAt  DateTime             @default(now())

  @@unique([zahtevId, korisnikId])
  @@index([korisnikId])
}

// ─── Nadzor integriteta verifikacija (anti-malverzacija, 1. krug) ─────────────
// Noćni cron (/api/cron/nadzor-integriteta) računa pravila P1–P15 nad grafom
// verifikacija i tokom POEN-a i upisuje OBELEŽENE naloge/grupe ovde. Sistem
// NIKAD sam ne preduzima radnju — samo evidentira i (za HITNO) javi superadminu;
// gašenje uvek povlači čovek. `subjektId` je plain string (bez FK na User) da
// model ostane labavo spregnut. Status CISTO = superadmin odbacio kao lažnu uzbunu.
model RizikNalaz {
  id        String    @id @default(uuid())
  tip       String // "NALOG" | "GRUPA"
  subjektId String? // userId za NALOG; null za GRUPA
  pseudonim String? // za prikaz (NALOG)
  clanovi   String? // JSON [{id,pseudonim}] za GRUPA
  pravila   String // JSON [{kod,nivo,opis}]
  rizik     Int // ukupan skor (zbir težina pravila)
  nivo      String // najviši nivo: "INFO" | "UPOZORENJE" | "HITNO"
  status    String    @default("OTVOREN") // "OTVOREN" | "CISTO"
  resenById String?
  resenAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([status, rizik(sort: Desc)])
  @@index([subjektId])
}

// ─── Prijava bagova (greške na platformi) ─────────────────────────────────────
// Bilo koji prijavljen korisnik može da prijavi bag (grešku). Lista svih prijava
// je javna (vidljiva svim prijavljenima) zajedno sa statusom — da svako vidi šta
// je prijavljeno i da li se na tome radi. Status menja admin.

enum BugStatus {
  PRIJAVLJEN // prijavljeno, još se ne radi
  U_RADU // radi se na tome
  RESENO // ispravljeno
  ODBIJENO // nije bag / neće se raditi
}

model Bug {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation("PrijaviocBaga", fields: [userId], references: [id])
  naslov    String
  opis      String
  status    BugStatus @default(PRIJAVLJEN)
  odgovor   String? // beleška/odgovor admina (npr. zašto je odbijeno ili kad je rešeno)
  resenoAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
}

// ─── Modul Deca — prijateljstva ─────────────────────────────────────────────
//
// Maloletni korisnici se povezuju skeniranjem QR koda, uživo. Prijateljstvo je
// SIMETRIČNO: jedan red opisuje obe strane, pa se `aId` i `bId` upisuju sortirano
// (manji id prvi). Bez toga bi isti par mogao da uđe dvaput, u dva smera, i
// jedinstveni indeks ne bi ništa značio.
//
// ─── Zašto red ostaje i posle raskida ──────────────────────────────────────
//
// Raskinut par SME da se obnovi (deca čl. 34 st. 4) — pomirene drugarice ne gube
// ništa trajno. Kad bi se red brisao, `@@unique([aId, bId])` ne bi imao šta da
// čuva i isti par bi mogao da postoji dvaput. Zato se raskid beleži `raskinutAt`,
// a obnova ga vraća na `null`.
model Prijateljstvo {
  id              String    @id @default(uuid())
  aId             String
  a               User      @relation("PrijateljA", fields: [aId], references: [id], onDelete: Cascade)
  bId             String
  b               User      @relation("PrijateljB", fields: [bId], references: [id], onDelete: Cascade)
  // Da li je 500 POEN upisano OBEMA stranama (deca čl. 33). Isplata čeka da obe strane
  // budu aktivne, pa red često stoji neisplaćen. Ovo polje je jedini izvor istine
  // o tome duguje li se otpis pri raskidu i pri punoletstvu — broj transakcija se
  // ne prebrojava unazad.
  poenEvidentiran Boolean   @default(false)
  evidentiranAt   DateTime?
  // Raskid (deca čl. 34). Raskinuti može samo dete, bilo koje od dvoje; roditelj ne
  // može. `raskinuoId` je zato uvek jedna od dve strane.
  raskinutAt      DateTime?
  raskinuoId      String?
  raskinuo        User?     @relation("PrijateljstvoRaskinuo", fields: [raskinuoId], references: [id])
  createdAt       DateTime  @default(now())

  @@unique([aId, bId])
  @@index([aId])
  @@index([bId])
}

// Jednokratni kod za povezivanje. 🔴 NEMA šestocifrenog broja, za razliku od koda
// za potvrdu stvarnosti — broj se može izdiktirati telefonom, a QR se mora POKAZATI.
// Zbog toga i kratko traje: kod koji živi satima može da se fotografiše i iskoristi
// daleko od deteta, a smisao je da se dvoje nađu jedno pored drugog.
model PrijateljToken {
  id         String   @id @default(uuid())
  token      String   @unique
  korisnikId String
  korisnik   User     @relation(fields: [korisnikId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  iskoriscen Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([korisnikId])
  @@index([expiresAt])
}

// ─── Projekti i kolektivne nabavke ───────────────────────────────────────────
// Pravilnik o KOLO sistemu čl. 18 i 47; Pravilnik o projektima i kolektivnim
// nabavkama (set 4.4.1).

/// Rečnik naziva dobara. Zaseban model, a ne slobodan tekst na predlogu: bez
/// rečnika bi „gorivo", „dizel" i „gorivo za traktor" bili tri stavke za istu
/// stvar, registar bi se rasprašio i nijedan naziv nikad ne bi skupio dovoljno
/// korisnika da se o njemu glasa (čl. 9 st. 2).
model NazivDobra {
  id         String           @id @default(uuid())
  /// Prikazni oblik, onako kako ga je uneo prvi korisnik.
  naziv      String
  /// Ključ za poklapanje bez obzira na veličinu slova i razmake. Jedinstven —
  /// isti razlog kao `User.pseudonimLower`.
  nazivLower String           @unique
  kreiraoId  String?
  kreirao    User?            @relation("KreiraoNaziv", fields: [kreiraoId], references: [id])
  predlozi   PredlogNabavke[]
  nabavke    Nabavka[]
  createdAt  DateTime         @default(now())

  @@index([createdAt])
}

/// Predlog za nabavku — jedna reč, jedan po korisniku (čl. 9 st. 3).
/// Jednokratnost drži BAZA (`userId @unique`), ne kod: nov predlog zamenjuje
/// raniji, pa je registar „jedan član — jedan glas o predmetu".
model PredlogNabavke {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nazivId   String
  naziv     NazivDobra @relation(fields: [nazivId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  // Registar grupiše po nazivu i broji različite korisnike.
  @@index([nazivId])
}

enum NabavkaStatus {
  NACRT // Fondacija prikuplja ponude, kalkulacija još nije objavljena
  OBJAVLJENA // kalkulacija objavljena, prijave otvorene (3 dana)
  RED_UTVRDJEN // prijave zatvorene, red snimljen, pozivi za potvrdu teku
  PLACENA // dobavljaču plaćeno, period preuzimanja teče (3 dana)
  ZAVRSENA
  OBUSTAVLJENA
}

enum NabavkaPrijavaStatus {
  PRIJAVLJEN // u redu, čeka poziv
  POZVAN // poziv poslat, teče rok za odgovor (3 dana)
  POTVRDIO // upisao dan preuzimanja, POEN rezervisan
  PREUZEO // POEN poništen protivzapisom
  ODUSTAO
  ISTEKAO // nije odgovorio na poziv u roku
  NIJE_PREUZEO // potvrdio, ali nije došao upisanog dana
}

/// Jedna kolektivna nabavka, od izbora predmeta do preuzimanja.
/// Svi brojevi kalkulacije se SNIMAJU na zapis u trenutku objave (čl. 18 st. 3:
/// kalkulacija se posle objave ne menja). Bez snimka bi se prikazana kalkulacija
/// menjala kad se promeni saldo Fondacije ili nabavna cena.
model Nabavka {
  id      String        @id @default(uuid())
  nazivId String
  naziv   NazivDobra    @relation(fields: [nazivId], references: [id])
  status  NabavkaStatus @default(NACRT)

  /// Glasanje kojim je predmet izabran (čl. 12). Null za nabavku koju je UO
  /// pokrenuo pre konstituisanja Gornjeg Kola.
  glasanjePredlogId String?          @unique
  glasanjePredlog   GlasanjePredlog? @relation(fields: [glasanjePredlogId], references: [id])

  // ── Sredstva (čl. 5 i 7) — snimak u trenutku objave
  saldoSnimak   Decimal? @db.Decimal(12, 2)
  rezervaSnimak Decimal? @db.Decimal(12, 2)
  iznosNabavke  Decimal? @db.Decimal(12, 2)

  // ── Ponuda i kalkulacija (čl. 13, 14, 16, 17, 18)
  dobavljac        String?
  jedinicaMere     String? // „vreća 25 kg" — samo za prikaz
  nabavnaCena      Decimal? @db.Decimal(12, 2)
  brojJedinica     Int?
  brojDelova       Int?
  velicinaDela     Int?
  /// Čl. 17 — broj POEN-a po delu koji je utvrdila odluka o nabavci. NE izvodi se
  /// iz cene dobra: do 4.4.3 je bio `velicinaDela × maloprodajna referenca`, čime
  /// je sistem objavljivao kurs POEN-a prema dinaru.
  poenPoDelu       Int?
  /// Čl. 17 st. 2 — obrazloženje kako je broj POEN-a po delu utvrđen. Objavljuje se
  /// kalkulacijom, jer je bez njega parametar odluke neproverljiv.
  poenObrazlozenje String?

  // ── Rokovi (čl. 19, 21, 24)
  prijaveDo        DateTime?
  mestoPreuzimanja String?
  preuzimanjeOd    DateTime?
  preuzimanjeDo    DateTime?

  objavljenoAt   DateTime?
  redUtvrdjenAt  DateTime?
  placenoAt      DateTime?
  placenoRSD     Decimal?  @db.Decimal(12, 2)
  zavrsenoAt     DateTime?
  obustavljenoAt DateTime?
  obustavaRazlog String?

  ponude  NabavkaPonuda[]
  prijave NabavkaPrijava[]
  trosak  ProjekatTrosak?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([nazivId])
}

/// Prikupljena ponuda (čl. 14). Objavljuju se SVE, i one koje nisu izabrane —
/// bez toga „najpovoljnija" nije provera nego tvrdnja.
model NabavkaPonuda {
  id             String   @id @default(uuid())
  nabavkaId      String
  nabavka        Nabavka  @relation(fields: [nabavkaId], references: [id], onDelete: Cascade)
  ponudjac       String
  cenaPoJedinici Decimal  @db.Decimal(12, 2)
  izabrana       Boolean  @default(false)
  napomena       String?
  createdAt      DateTime @default(now())

  @@index([nabavkaId])
}

/// Prijava korisnika na nabavku i njegovo mesto u redu.
model NabavkaPrijava {
  id        String               @id @default(uuid())
  nabavkaId String
  nabavka   Nabavka              @relation(fields: [nabavkaId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    NabavkaPrijavaStatus @default(PRIJAVLJEN)

  /// 🔴 SNIMAK broja POEN-a u trenutku isteka roka za prijavu (čl. 20 st. 2).
  /// Red mora biti snimak, ne živa vrednost: rolanje poziva traje danima, a ljudi
  /// u međuvremenu troše POEN — pri živom rangiranju red bi se premeštao pod
  /// nogama onima koji čekaju poziv.
  poenSnimak Int?
  /// Mesto u redu, 1 = prvi. Utvrđuje se zajedno sa snimkom.
  mesto      Int?

  pozvanAt       DateTime?
  potvrdjenoAt   DateTime?
  danPreuzimanja DateTime?
  /// Kod koji korisnik pokazuje dobavljaču. Dobavljač dobija SAMO spisak kodova —
  /// nikad pseudonim ni bilo koji drugi podatak o licu (čl. 24 st. 3).
  kod            String?   @unique
  preuzetoAt     DateTime?

  /// Rezervisan POEN dok traje potvrda. Nula kad nema rezervacije — Novčanik red
  /// prikazuje samo kad postoji.
  rezervisano Int @default(0)

  /// Ispravka poništenja po prijavljenom nedostatku (nabavke čl. 35 st. 1 t. 1).
  /// Postoji da se ista prijava ne bi ispravila dvaput; iznos je snimak, jer
  /// `poenPoDelu` nabavke može biti drugačiji u nekoj kasnijoj nabavci.
  ispravljenoAt   DateTime?
  ispravljenoPoen Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Jedna prijava po korisniku po nabavci — brana drži baza, ne kod.
  @@unique([nabavkaId, userId])
  @@index([nabavkaId, status])
  @@index([nabavkaId, mesto])
  @@index([userId])
}

/// Dinarski odliv u projekat.
///
/// 🔴 NE ide u `FondacijaTrosak`. `dohvatiTrosakPrethodnogMeseca()` sabira sve
/// redove tog modela, a `pragZaGasenje = trosak × 3` — nabavka od 200.000 RSD
/// podigla bi prag za 600.000 RSD, pa bi se zaštitni veto najteže gasio baš u
/// mesecima kada Fondacija najviše radi. Saldo se umanjuje i za projekte
/// (`dohvatiSaldoFondacije`), ali prag meri SAMO operativu.
model ProjekatTrosak {
  id        String   @id @default(uuid())
  nabavkaId String?  @unique
  nabavka   Nabavka? @relation(fields: [nabavkaId], references: [id])
  datum     DateTime @db.Date
  iznosRSD  Decimal  @db.Decimal(12, 2)
  opis      String
  kreiraoId String
  kreirao   User     @relation("KreiraoProjekatTrosak", fields: [kreiraoId], references: [id])
  createdAt DateTime @default(now())

  @@index([datum])
}

/// Stanje gazdinstva (Pravilnik o gazdinstvima čl. 4–7, 19–21).
enum GazdinstvoStatus {
  /// Prijava je otvorena; podnosilac postavlja oglase i poziva članove.
  NACRT
  NA_PREGLEDU
  /// Fondacija vratila na dopunu (čl. 7 st. 2) — razlog u `razlogVracanja`.
  VRACENO
  ODOBRENO
  /// Odobrenje poništeno zbog lažne izjave (čl. 20).
  PONISTENO
  /// Gazdinstvo ostalo bez članova ili ga je podnosilac povukao.
  UGASENO
}

enum UlogaUGazdinstvu {
  NOSILAC
  CLAN
}

enum ClanGazdinstvaStatus {
  POZVAN
  /// Prihvatio poziv uz izjavu; pre odobrenja gazdinstva čeka odobrenje gazdinstva,
  /// posle njega čeka da Fondacija pregleda pristupanje (gazd. čl. 9 st. 4).
  PRISTUPIO
  ODOBREN
  ODBIJEN
  ISTUPIO
}

/// Gazdinstvo (Pravilnik čl. 39, Pravilnik o gazdinstvima). Nije korisnik ni
/// kolektivni oblik i NEMA zapis u Protokolu — doprinos ide u lični zapis člana.
///
/// Lokacija je tačna (koordinate), ali se adresa ne ispisuje bez izjave (gazd. čl. 19). BPG je
/// neobavezan i nikad se ne prikazuje drugim korisnicima.
model Gazdinstvo {
  id                 String           @id @default(uuid())
  naziv              String
  /// Broj poljoprivrednog gazdinstva; null uz `neregistrovano = true` ili kad nije naveden.
  bpg                String?
  neregistrovano     Boolean          @default(false)
  /// Naselje iz šifarnika (`razresiNaselje`).
  naselje            String
  /// Adresa gazdinstva (Pravilnik o gazdinstvima čl. 5 st. 1 t. 3, set 4.7.5) — obavezna
  /// za novu prijavu, vidi je SAMO administratorski tim; nikad u javni prikaz.
  /// Zatečeni redovi ostaju `null` (CLAUDE.md pravilo 11).
  adresa             String?
  lat                Float?
  lng                Float?
  /// Izjava podnosioca da je saglasan da se adresa prikazuje uz tačku na mapi
  /// (Pravilnik o gazdinstvima čl. 5 st. 1 t. 3). 🔴 Nije opoziv pristanak — izlaz je
  /// samo brisanje gazdinstva (čl. 21). Gazdinstva odobrena ranije ostaju `null`
  /// i adresa im se ne ispisuje dok upravljač ne da izjavu.
  izjavaAdresaAt     DateTime?
  /// Gazdinstvo obrisano sa platforme (gazd. čl. 21 st. 1): status UGASENO, podaci brisani.
  obrisanoAt         DateTime?
  opis               String
  status             GazdinstvoStatus @default(NACRT)
  /// Član koji upravlja gazdinstvom na platformi (gazd. čl. 11, 12) — podnosilac, nosilac koji je preuzeo, ili sledeći po redu.
  upravljaId         String?
  razlogVracanja     String?
  podnetoAt          DateTime?
  odobrenoAt         DateTime?
  odobrioId          String?
  ponistenoAt        DateTime?
  ponistioId         String?
  razlogPonistenja   String?
  ugasenoAt          DateTime?
  /// Fondacija je pri odobrenju uporedila ime nosioca i BPG sa izvodom iz RPG (dokaz
  /// stvarnosti čl. 4a st. 2 t. 3). Izvod se ne čuva — beleži se samo da je poređenje izvršeno.
  rpgUporedjenAt     DateTime?
  rpgUporedioId      String?
  /// Od kada gazdinstvo sme imati članove (gazd. čl. 4 st. 2, čl. 14; set 4.8.2). Postavlja se
  /// kad je podnosilac član Kola ili osnivač; monotono — pad potvrđenosti ga ne briše.
  smeClanoveOd       DateTime?
  /// Od kada bar jedan član neprekidno ima aktivan oglas kojim nudi (pokazatelj Z5,
  /// „stalna ponuda“; `protokol/pokazatelji.ts`). Upisuje ga noćni obračun: dan bez
  /// ponude vraća `null`. Stanje gazdinstva, ne istorija lica.
  ponudaNeprekidnoOd DateTime?
  /// Telefon za razgovor Fondacije sa nosiocem (gazd. čl. 5 st. 1 t. 9, čl. 8) — nosioca,
  /// odnosno podnosioca kad nosilac nema nalog. Vidi ga samo admin; briše se odlukom.
  telefonZaRazgovor  String?
  /// Fondacija je razgovarala sa nosiocem pre odobrenja (gazd. čl. 8).
  razgovorObavljenAt DateTime?
  /// Ko je razgovor zabeležio: admin ili član Kola koji je nosioca pozvao sa spiska
  /// za poziv (gazd. čl. 8 st. 2; set 4.8.3). Zatečeni redovi su null.
  razgovorBeleziId   String?
  /// Član Kola posle razgovora sa spiska: postoji osnov za sumnju (gazd. čl. 8 st. 4).
  razgovorSumnja     Boolean?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  clanovi     ClanGazdinstva[]
  oglasi      MarketplaceListing[]
  doprinosi   DoprinosGazdinstva[]
  izvodRpg    IzvodRpg?
  upitiIzjave UpitIzjaveGazdinstva[]

  @@index([status])
}

/// Članstvo u gazdinstvu. Samo punoletni nalozi (Pravilnik o učešću dece čl. 29 st. 3).
/// Lice je aktivan član najviše jednog gazdinstva — proverava servis; živ doprinos
/// ima najviše jedan — to drži BAZA (`DoprinosGazdinstva.aktivanKljuc @unique`, set 4.8.2).
model ClanGazdinstva {
  id                 String               @id @default(uuid())
  gazdinstvoId       String
  gazdinstvo         Gazdinstvo           @relation(fields: [gazdinstvoId], references: [id], onDelete: Cascade)
  userId             String
  user               User                 @relation("ClanGazdinstva", fields: [userId], references: [id], onDelete: Cascade)
  uloga              UlogaUGazdinstvu     @default(CLAN)
  status             ClanGazdinstvaStatus @default(POZVAN)
  pozvaoId           String?
  pozvanAt           DateTime             @default(now())
  /// Trenutak prihvatanja poziva — određuje red pristupanja (gazd. čl. 15 st. 2).
  pristupioAt        DateTime?
  odobrenAt          DateTime?
  istupioAt          DateTime?
  /// Izjava o tačnosti podataka, snimljena pri prihvatanju (ne generiše se ponovo pri čitanju).
  izjavaTekst        String?
  izjavaAt           DateTime?
  /// Broj telefona za razgovor sa Fondacijom pre odobrenja (Pravilnik o gazdinstvima
  /// čl. 6a, set 4.8.1). Vidi ga samo admin; briše se odlukom o prijavi odnosno
  /// pristupanju. 🔴 Od seta 4.8.2 stari zapis koji se ne čita (razgovor samo sa
  /// nosiocem — `Gazdinstvo.telefonZaRazgovor`).
  telefon            String?
  /// Fondacija je razgovarala sa članom pre odobrenja. Bez toga nema odobrenja.
  razgovorObavljenAt DateTime?

  doprinos    DoprinosGazdinstva?
  upitiIzjave UpitIzjaveGazdinstva[]

  @@unique([gazdinstvoId, userId])
  @@index([userId, status])
}

/// Doprinos gazdinstva (Pravilnik čl. 39). Beleži se pri odobrenju gazdinstva,
/// odnosno pristupanja; evidentira se kad je član verifikovan i ima objavljen oglas.
/// Set 4.8.2: doprinos se može PONOVO steći posle poništenja ili otpisa pri
/// prestanku (gazd. čl. 17, 24), pa `userId`
/// više nije jedinstven. Živ doprinos (ZABELEZEN/EVIDENTIRAN, neotpisan) je najviše
/// jedan po licu — to drži `aktivanKljuc @unique` (= userId dok je živ, null posle).
model DoprinosGazdinstva {
  id                 String         @id @default(uuid())
  userId             String
  /// = `userId` dok je doprinos živ; null pri poništenju ili otpisu.
  aktivanKljuc       String?        @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gazdinstvoId       String
  gazdinstvo         Gazdinstvo     @relation(fields: [gazdinstvoId], references: [id], onDelete: Cascade)
  clanId             String         @unique
  clan               ClanGazdinstva @relation(fields: [clanId], references: [id], onDelete: Cascade)
  /// Red u gazdinstvu (1 = prvi član) — iz njega je izveden iznos.
  redniBroj          Int
  iznos              Int
  status             DoprinosStatus @default(ZABELEZEN)
  transakcijaId      String?
  zabelezenAt        DateTime       @default(now())
  evidentiranAt      DateTime?
  obavestenAt        DateTime?
  ponistenAt         DateTime?
  /// Otpis po Pravilniku čl. 17 st. 2 t. 6 (prestanak gazdinstva, set 4.8.2; do 4.8.1 t. 7).
  otpisanAt          DateTime?
  otpisTransakcijaId String?

  /// Redni broj je jedinstven u gazdinstvu — brana protiv sedmog doprinosa pod
  /// istovremenim odobrenjima (set 4.7.7).
  @@unique([gazdinstvoId, redniBroj])
  @@index([gazdinstvoId])
  @@index([status])
  @@index([userId])
}

/// Izvod iz Registra poljoprivrednih gazdinstava koji prilaže korisnik ili član bez
/// potvrde kao nosilac (gazd. čl. 4b st. 1–4; Pravilnik čl. 40c st. 5; set 4.8.2).
/// Čuva se u bazi (≤ 5 MB), čita ga samo admin, BRIŠE SE pri svakoj odluci o prijavi.
model IzvodRpg {
  id           String     @id @default(uuid())
  gazdinstvoId String     @unique
  gazdinstvo   Gazdinstvo @relation(fields: [gazdinstvoId], references: [id], onDelete: Cascade)
  sadrzaj      Bytes
  contentType  String
  velicina     Int
  otpremioId   String
  otpremljenAt DateTime   @default(now())
}

enum UpitIzjaveStatus {
  CEKA
  PREUZETA
  ODBIJENA
  ISTEKLA
}

/// Upit članu gazdinstva da preuzme izjavu kad lice koje za nju odgovara istupi
/// (gazd. čl. 13, 21 st. 3, 22 st. 1 t. 1; set 4.8.2). Rok 30 dana.
model UpitIzjaveGazdinstva {
  id           String           @id @default(uuid())
  gazdinstvoId String
  gazdinstvo   Gazdinstvo       @relation(fields: [gazdinstvoId], references: [id], onDelete: Cascade)
  clanId       String
  clan         ClanGazdinstva   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  status       UpitIzjaveStatus @default(CEKA)
  upucenAt     DateTime         @default(now())
  rokDo        DateTime
  odgovorAt    DateTime?

  @@index([status, rokDo])
  @@index([gazdinstvoId])
}

// ─── Evidencija identiteta (Pravilnik čl. 31, set 4.7.3) ────────────────────
// Zasebna evidencija od evidencije doprinosa: veza pseudonim → ime i prezime.
// Upisuje se iz tri izvora (gazdinstvo, javna donacija, zadruga), jedno ime po
// nalogu. 🔴 Ne prikazuje se drugim korisnicima i ne ulazi u zapise POEN-a; čitaju
// je samo administratorski tim, izvoz podataka i brisanje naloga. Briše se gašenjem
// naloga. JMBG ni podaci iz isprava se ne upisuju. Upis samo kroz
// `src/lib/protokol/identitet.ts`. Brana: `__tests__/identitet-izvor.test.ts`.

enum IzvorIdentiteta {
  GAZDINSTVO
  DONACIJA
  ZADRUGA
  POKROVITELJSTVO
  /// Ulazak na spisak za poziv (Pravilnik čl. 31 st. 2, set 4.8.4; N4-M2).
  SPISAK_ZA_POZIV
}

model IdentitetNaloga {
  id         String          @id @default(uuid())
  userId     String          @unique
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  imePrezime String
  /// Izvor iz koga je ime prvi put upisano.
  izvor      IzvorIdentiteta
  upisanAt   DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

/// Utvrđenje višestrukog naloga istog lica (Pravilnik o dokazu stvarnosti čl. 14,
/// set 4.8.4; registar 2026-10, N4-M3). Jedan red po ugašenom nalogu. Utvrđuje samo
/// Fondacija (superadmin), uz obrazloženje; lice zadržava nalog `zadrzaniId`.
///
/// 🔴 Uz utvrđenje se otvara JEDAN nadzorni predmet nad primaocima prepisa sa
/// ugašenog naloga (`predmet*`): pitanje je samo da li je primalac isto lice ili su
/// prepisi fiktivni. Predmet nema dejstvo na naloge primalaca dok se ništa ne utvrdi
/// i otvara se samo po utvrđenju — nije praćenje prepisa.
model UtvrdjenjeVisestrukogNaloga {
  id                String    @id @default(uuid())
  zadrzaniId        String
  ugaseniId         String    @unique
  /// Pseudonim ugašenog naloga u trenutku utvrđenja (nalog prestaje).
  ugaseniPseudonim  String
  obrazlozenje      String
  utvrdioId         String
  utvrdjenoAt       DateTime  @default(now())
  /// Neto prepis sa ugašenog naloga na zadržani, otpisan tipom
  /// `OTPIS_VISESTRUKI_NALOG` (osmi osnov, Pravilnik čl. 17 st. 2 t. 8). 0 kad
  /// neto prepisa nije bilo.
  otpisano          Int       @default(0)
  otpisTxId         String?
  /// Isključenje lica (Uslovi čl. 32) kad je drugi nalog korišćen za sticanje
  /// POEN-a ili glasa.
  iskljucen         Boolean   @default(false)
  /// Nadzorni predmet nad primaocima prepisa sa ugašenog naloga.
  predmetOtvoren    Boolean   @default(true)
  predmetBeleska    String?
  predmetZatvorioId String?
  predmetZatvorenAt DateTime?

  @@index([zadrzaniId])
  @@index([predmetOtvoren])
}

// ─── Kutija želja u dečjem prostoru (whitepaper 5.0, pogl. 7; 25.10.2026) ────
/// Stanje predloga deteta. `NA_PREGLEDU → PRIKAZAN | ODBIJEN`, `PRIKAZAN → ODGOVOREN`.
enum StanjeZelje {
  NA_PREGLEDU
  PRIKAZAN
  ODBIJEN
  ODGOVOREN
}

/// Predlog deteta za dečji prostor (nova funkcija, igra ili pravilo).
/// 🔴 Autor se nikad ne vraća klijentu — ni kao id (`kutija-zelja-pravila.ts`).
/// Predlog ne donosi POEN i ne obavezuje Fondaciju. Briše se sa svim podrškama i
/// odgovorom pri brisanju naloga deteta, svakom izlasku naloga i punoletstvu
/// (odluka vlasnika 25.10.2026).
model ZeljaDeteta {
  id              String          @id @default(uuid())
  autorId         String
  autor           User            @relation("ZeljaAutor", fields: [autorId], references: [id], onDelete: Cascade)
  tekst           String
  stanje          StanjeZelje     @default(NA_PREGLEDU)
  /// Ko je iz Fondacije pregledao predlog pre prikaza, i kada.
  pregledaoId     String?
  pregledao       User?           @relation("ZeljaPregledao", fields: [pregledaoId], references: [id], onDelete: SetNull)
  pregledanoAt    DateTime?
  /// Razlog odbijanja — prikazuje se autoru, jednostavnim jezikom.
  razlogOdbijanja String?
  createdAt       DateTime        @default(now())
  podrske         PodrskaZelje[]
  odgovor         OdgovorNaZelju?

  @@index([autorId])
  @@index([stanje])
}

/// Podrška predlogu — jedan glas po detetu po predlogu; povlači se brisanjem reda.
model PodrskaZelje {
  id        String      @id @default(uuid())
  zeljaId   String
  zelja     ZeljaDeteta @relation(fields: [zeljaId], references: [id], onDelete: Cascade)
  deteId    String
  dete      User        @relation("ZeljaPodrska", fields: [deteId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([zeljaId, deteId])
  @@index([deteId])
}

/// Obrazložen odgovor Fondacije na prikazan predlog (šta će uraditi, šta neće i zašto).
model OdgovorNaZelju {
  id          String      @id @default(uuid())
  zeljaId     String      @unique
  zelja       ZeljaDeteta @relation(fields: [zeljaId], references: [id], onDelete: Cascade)
  tekst       String
  odgovorioId String?
  odgovorio   User?       @relation("ZeljaOdgovorio", fields: [odgovorioId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
}
