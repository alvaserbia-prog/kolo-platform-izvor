  zaposleniDavaoca                 DavalacZaposleni[]             @relation("DavalacZaposleniDavalac")
  upisiPokrovitelja                UpisPokrovitelja[]             @relation("VlasnikUpisa")
  zaposlenKodDavaoca               DavalacZaposleni[]             @relation("DavalacZaposleniZaposleni")
  prijaveRaspodele                 PrijavaRaspodele[]
  prijavljeniBagovi                Bug[]                          @relation("PrijaviocBaga")
  sistemskaObavestenja             SistemskoObavestenje[]         @relation("KreiraoObavestenje")
  pseudonimIstorija                PseudonimIstorija[]
