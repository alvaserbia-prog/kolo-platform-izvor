  IZVRSENO // UO sproveo odluku svojim aktom (čl. 46 Pravilnika, čl. 17 Pravilnika o Gornjem Kolu)
  VETO_OBUSTAVLJENO // izvršenje obustavljeno zaštitnim vetom (veto ukinut u setu 5.0; vrednost ostaje kao istorija)
  NIJE_SPROVEDENO // UO odbio da sprovede odluku iz razloga sa zatvorene liste (Pravilnik čl. 46 st. 3)
}

// Zatvorena lista razloga za odbijanje sprovođenja odluke Gornjeg Kola (čl. 46 st. 3
// Pravilnika, set 4.4.6). Zaštitni veto NIJE ovde — on ima sopstveni status
// VETO_OBUSTAVLJENO, koji ostaje kao istorija (veto ukinut u setu 5.0).
enum OdbijanjeRazlog {
  ZAKON // odluka je suprotna zakonu
  STATUT // odluka je suprotna Statutu Fondacije
  VAN_NADLEZNOSTI // pitanje izuzeto iz nadležnosti Gornjeg Kola (Pravilnik čl. 45)
}

