}

enum ZrnoStatusAkcija {
  ZAKLJUCAJ
  OTKLJUCAJ
}

enum PredlogStatus {
  ACTIVE
  CLOSED
}

// Zašto se o predlogu Gornjeg Kola nije glasalo (Pravilnik o Gornjem Kolu čl. 10 st. 3–4).
enum NeglasanjeRazlog {
  NEPODRZAN // do kraja perioda podrške niko ga nije podržao (čl. 10 st. 4)
  NEDOPUSTEN // nedopušten predlog (čl. 6 st. 3) — ko to utvrđuje, čeka odluku vlasnika
}

