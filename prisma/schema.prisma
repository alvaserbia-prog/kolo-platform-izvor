generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enumi ───────────────────────────────────────────────────────────────────

enum WalletType {
  USER
  KRUG
  PROTOKOL
}

enum KrugStatus {
  ACTIVE
  SUSPENDED
}

enum KrugOsnivanjeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PristupnicaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectType {
  PRIKUPLJANJE
  REDISTRIBUCIJA
}

enum ListingStatus {
  ACTIVE
  RAZMENJEN
  EXPIRED
  UKLONJEN // Fondacija uklonila zbog povrede Uslova/Pravilnika/zakona
}

// Smer oglasa na Pijaci: PONUDA = oglašivač nudi dobro/uslugu (klasičan oglas),
// POTRAZNJA = oglašivač traži nekoga da uradi/napravi nešto („traži se").
// Kod POTRAZNJA budžet se uvek dogovara (cenaTip = DOGOVOR, bez iznosa).
enum TipOglasa {
  PONUDA
  POTRAZNJA
}

// Varijanta cene na oglasu Pijace (bira je oglašivač).
enum CenaTip {
  FIKSNA // jedan iznos
  RASPON // od–do
  DOGOVOR // bez iznosa, „po dogovoru"
}

enum TransactionType {
  TRANSFER
  EMISIJA_VERIFIKACIJA
  EMISIJA_NADZOR
  EMISIJA_DONACIJA
  EMISIJA_POKROVITELJ
  EMISIJA_KRUG_OSNIVANJE
  EMISIJA_KRUG_BONUS
  /// Socijalni programi (Podrška majkama, Podrška starijima, Posebna briga,
  /// Školovanje). 🔴 Naziv programa NE ide u opis transakcije i pojedinačan red
  /// NE izlazi u javne prikaze (R-03, mera M-1): naziv je posebna kategorija po
  /// ZZPL čl. 17, a iznos sam invertuje godište (Podrška starijima) odnosno broj
  /// i uzrast dece (Podrška majkama). Javno se objavljuje dnevni agregat po
  /// programu iz `DailyEmissionSummary.breakdown`.
  EMISIJA_PROGRAM
  /// Operativni doprinos (Pravilnik čl. 34). Do R-03 je delio tip sa socijalnim programima,
  /// pa se u javnom prikazu nije mogao razdvojiti od njih. Nije posebna kategorija
  /// i ostaje vidljiv pojedinačno.
  EMISIJA_OPERATIVNI
  UPIS_ZRNO
  OTPIS_ZRNO
  EMISIJA_OSNIVACKI
  EMISIJA_SADRZAJ // doprinos sadržaju platforme (Pravilnik čl. 19 t. 8, čl. 38)
  EMISIJA_RAZMENA // doprinos razmeni — koraci 2–5 putanje prvog kruga (ukinuta setom 4.8.0)
  PONISTENJE_PREPISA // protivzapis prepisa poništenog po prijavi razmene
  // Modul Deca: 500 POEN po sklopljenom prijateljstvu, obema stranama (deca čl. 33).
  // Zaseban tip, da se u istoriji i u opticaju vidi šta je došlo iz dečjeg prostora.
  EMISIJA_PRIJATELJSTVO
  // Protivzapis Protokola pri raskidu prijateljstva i pri prelasku u punoletstvo
  // (deca čl. 34, 35). Nije „poništenje prepisa" — poništava se EMISIJA, pa opticaj
  // opada, dok prepis samo seli POEN između dva korisnička zapisa.
  OTPIS_PRIJATELJSTVO
  // Prevođenje punoletnog naloga u maloletni: poništenje svega što je Protokol
  // upisao tom nalogu, i skidanje POENA ljudima kojima je upisan povodom njegovih
  // potvrda. Poništava se EMISIJA, pa opticaj opada.
  OTPIS_PREVOD_U_MALOLETNI
  // Kolektivna nabavka: poništenje zapisa PO ISKORIŠĆENJU (Pravilnik čl. 18).
  // Poništava se EMISIJA — Protokolov minus se smanjuje i opticaj opada. Nije
  // PONISTENJE_PREPISA: tamo se POEN seli između dva korisnička zapisa, ovde
  // nestaje iz sistema zato što je iskorišćen.
  OTPIS_NABAVKA
  /// Jednokratno usklađivanje zatečenih potvrda sa dokazom stvarnosti čl. 7 (set
  /// 4.6.4): POEN upisan po ranijem pravilu vraća se u „zabeleženo" onima koji nemaju
  /// nijedan trag učešća. Zaseban tip, da se u istoriji vidi da to NIJE ni poništenje
  /// lažne potvrde (dokaz stvarnosti čl. 35) ni otpis — nego prelazna radnja, i da se može prebrojati.
  /// Povlači se pun iznos, bez kapiranja: zapis sme u minus po petom osnovu iz
  /// Pravilnika čl. 17 st. 2 t. 5 (dokaz stvarnosti čl. 39; `potvrde-uskladjivanje.ts`).
  USKLADJIVANJE_POTVRDE
  /// Ispravka poništenja po iskorišćenju kad uslov iskorišćenja nije bio ispunjen
  /// (Pravilnik čl. 18 st. 5, nabavke čl. 35). Protokol → korisnik; NIJE upis kroz
  /// kanal iz čl. 19 nego otklanjanje poništenja izvršenog bez osnova.
  ISPRAVKA_NABAVKA
  /// Poništenje zapisa POEN-a uz protivzapis Protokola (Pravilnik čl. 33): prestanak
  /// statusa (gašenje naloga i kaskada potvrda tog naloga), poništenje lažne potvrde
  /// (dokaz stvarnosti čl. 35) i brisanje dečjeg naloga. Do 06.10.2026. ove radnje su upisivane kao
  /// `TRANSFER`, pa su ulazile u brojač razmena i zbir prepisa (pravilo 5). Zatečeni
  /// redovi ostaju `TRANSFER` — istorija se ne prepravlja; brojač ih isključuje
  /// uslovom u `USLOV_RAZMENE`.
  PONISTENJE_ZAPISA
  /// Modul Zadruga (Pravilnik o zadrugama čl. 11). Prepis iz zapisa zadruge ili u
  /// njega — uvek uz osnov, svaki svojim tipom, nikad `TRANSFER`: brojač razmena
  /// i zbir prepisa među korisnicima ne smeju ih brojati, a osnov mora ostati u
  /// zapisu zauvek.
  /// Zadruga → korisnik: dobro primljeno na raspodelu (čl. 12 st. 1).
  ZADRUGA_PRIJEM
  /// Zadrugar odnosno druga zadruga → zadruga: dobro izdato iz raspodele (čl. 12 st. 2).
  ZADRUGA_IZDAVANJE
  /// Zadruga → izvršilac: zadatak zadruge (čl. 16; do seta 5.0 „zadružni doprinos“).
  ZADRUGA_DOPRINOS
  /// Zadrugar → zadruga: korišćenje opreme, mehanizacije ili zemljišta (čl. 11 st. 1 t. 4).
  ZADRUGA_OPREMA
  /// Usluga koju zadruga pruža ili prima (čl. 11 st. 1 t. 5); smer čita se iz zapisa.
  ZADRUGA_USLUGA
  /// Prestanak učešća zadruge: POEN zapisa zadruge poništava se protivzapisom u
  /// korist Protokola (Pravilnik o KOLO sistemu čl. 50 st. 4). Opticaj opada.
  PONISTENJE_ZAPISA_ZADRUGE
  /// Doprinos gazdinstva (Pravilnik čl. 39) — sopstveni tip, da se iz brojača
  /// kanala 8 ne pomeša sa prvim oglasom (EMISIJA_SADRZAJ) ni sa putanjom.
  EMISIJA_GAZDINSTVO
  /// Otpis po prestanku gazdinstva — šesti osnov negativnog zapisa
  /// (Pravilnik čl. 17 st. 2 t. 6). Zapis SME u minus.
  OTPIS_GAZDINSTVO
  /// Pokroviteljstvo dobrima i uslugama (Pravilnik o pokroviteljstvu i donacijama
  /// Glava IV, čl. 33). Sopstveni tip, ne `EMISIJA_POKROVITELJ`: brojači putanja
  /// i opticaj ne smeju da mešaju novac i robu (odluka vlasnika, 19.10.2026).
  EMISIJA_POKROVITELJ_DOBRA
  /// Poništenje POEN-a imaoca vaučera PRI UZIMANJU vaučera (nabavke čl. 33 st. 4,
  /// Pravilnik čl. 18), ne pri iskorišćenju; istek ga ne ispravlja (čl. 34 st. 4).
  /// Korisnik → Protokol; opticaj opada.
  PONISTENJE_VAUCER
  /// Ispravka poništenja izvršenog bez predaje dobra, odnosno pružanja usluge
  /// (nabavke čl. 35, Pravilnik čl. 18 st. 5). Protokol → korisnik.
  ISPRAVKA_VAUCER
  /// Otpis po neizvršenju pokroviteljstva dobrima i uslugama — sedmi osnov
  /// negativnog zapisa (Pravilnik čl. 17 st. 2 t. 7; donacije čl. 35). Zapis SME u minus.
  OTPIS_POKROVITELJ_DOBRA
  /// Otpis neto prepisa sa ugašenog naloga na nalog koji ostaje, po utvrđenju
  /// višestrukog naloga istog lica — osmi osnov negativnog zapisa (Pravilnik čl. 17 st. 2
  /// t. 8; dokaz stvarnosti čl. 14; registar 2026-10, N4-M3). Korisnik → Protokol;
  /// zapis SME u minus. Nikad `TRANSFER`.
  OTPIS_VISESTRUKI_NALOG
}

enum TipKorisnika {
  REGULARNI
  NOSILAC_ZRNA
  NEVERIFIKOVAN
}

// Operativna ovlašćenja (admin osa), nezavisna od članskog tipa (TipKorisnika).
// NONE = običan član; ADMIN = svakodnevna operativa; SUPERADMIN = sve + opasne
// radnje + verifikuje prve ljude (koren lanca jemstva).
enum AdminNivo {
  NONE
  ADMIN
  SUPERADMIN
  /// Lice koje predloži zadruga (Pravilnik o zadrugama čl. 15, registar 2026-10 U2):
  /// radi samo u svojoj zadruzi (`User.adminZadrugaId`), van nje ne vidi ništa.
  ZADRUGA
}

