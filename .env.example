# ─────────────────────────────────────────────────────────────────────────────
# KOLO Platforma — primer env varijabli. Kopiraj u `.env` i popuni vrednosti.
# NIKAD ne commit-uj pravi `.env` sa tajnama u repozitorijum.
# ─────────────────────────────────────────────────────────────────────────────

# Baza i autentikacija
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ADMIN_EMAIL=

# Cron (Vercel) i režim održavanja
CRON_SECRET=
MAINTENANCE_MODE=false
# Rani pristup ("early access"): dok je MAINTENANCE_MODE=true, osoba koja zna ovaj
# kod može na /rani-pristup da otključa prijavu i registraciju (za rane prihvatioce).
# Ostavi prazno da bi rani pristup bio isključen. Promena koda poništava ranije izdate pristupe.
RANI_PRISTUP_KOD=

# OAuth (Google) — opciono
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend) — opciono
# Bez RESEND_API_KEY slanje je no-op (log u konzolu), aplikacija radi normalno.
# Pokriva reset lozinke, admin upozorenja i obaveštenja korisnicima.
# Linkovi u mejlu se grade iz NEXTAUTH_URL (fallback NEXT_PUBLIC_BASE_URL).
RESEND_API_KEY=
RESEND_FROM=
# Primalac admin upozorenja (posaljiAdminAlert) — bez njega admin mejl ne ide.
ADMIN_EMAIL=

# Telegram — opciono
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kartično plaćanje (NestPay) uklonjeno je setom 5.0.9 (donacije čl. 4 st. 1): donacija se
# uplaćuje samo sa računa — IPS QR kod (IPS_RACUN, IPS_PRIMALAC; `src/lib/placanje/ips-qr.ts`) ili nalog za prenos.
